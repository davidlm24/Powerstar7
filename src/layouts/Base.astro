---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/grid.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { levelsCss, stepsKeyframes } from '../lib/bayer';
import { useTranslations, ROUTES, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Omitted only by the 404, which has no canonical URL of its own. */
  page?: PageKey;
  title: string;
  description?: string;
  /** The themes (src/styles/themes.css). Every page uses 'switch' since the
      2026-11-26 rollout: dark by default, and the header's theme button lets
      the visitor change it. 'dark' / 'light' pin one. */
  theme?: 'dark' | 'light' | 'switch';
}

const { lang, page, title, description, theme = 'switch' } = Astro.props;
// Every page is themed since the 2026-11-26 rollout (theme defaults to
// 'switch'); kept as a name so the head reads clearly.
const themed = true;
const dark = theme === 'dark' || theme === 'switch';
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://www.designactiv.com');
const desc = description ?? t('site.description');
const canonical = page ? new URL(ROUTES[page][lang], site).href : null;
/* A WhatsApp referral sees this card before it sees the site, so PT pages get
   the Portuguese card. Both come from scripts/og-card.mjs. */
const ogImage = new URL(lang === 'pt' ? '/assets/img/og-card-pt.png' : '/assets/img/og-card.png', site).href;

/* The print coming up: every 4x4 Bayer level as a CSS mask (--dz-0 … --dz-16)
   and the keyframes that step through them (src/lib/bayer.ts). A reply
   that changes in front of the visitor develops in dots (the form's status,
   a swapped price: .print-now, global.css), and the grid's title cells use
   one level for their faint dots (grid.css). Data URIs in custom
   properties, 485 bytes gzipped; not a request. */
const dz = `:root{${levelsCss()}}${stepsKeyframes('dz-in', 0, 16)}`;
---

<!doctype html>
<html lang={lang} class:list={['no-js', dark && 'theme-dark', theme === 'light' && 'theme-light']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!page && <meta name="robots" content="noindex" />}

    {/* Both languages are declared on every page, so a Portuguese-speaking
        visitor landing on an English URL is offered the real Portuguese page
        rather than a 301 to English — which is what the old site did. */}
    {
      page && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(ROUTES[page].en, site).href} />
          <link rel="alternate" hreflang="pt" href={new URL(ROUTES[page].pt, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(ROUTES[page].en, site).href} />
        </>
      )
    }

    <Fragment set:html={`<style>${dz}</style>`} />

    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={dark ? '#0e0e0c' : theme === 'light' ? '#f9f9f9' : '#f5f2eb'} />
    {themed && <meta name="color-scheme" content={dark ? 'dark light' : 'light'} />}
    {/* The visitor's own choice, applied before first paint so the page
        never flashes the other theme. Dark is the default; storage can be
        missing or blocked, and then dark simply stays. */}
    {
      theme === 'switch' && (
        <script is:inline>
          try {
            if (localStorage.getItem('designactiv-theme') === 'light') {
              var h = document.documentElement;
              h.classList.remove('theme-dark');
              h.classList.add('theme-light');
              document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f9f9f9');
            }
          } catch (e) {}
        </script>
      )
    }

    {
      /* The footer's Animation switch: applied before the
         first paint, so a page never starts moving and then stops. */
      themed && (
        <script is:inline>
          try {
            if (localStorage.getItem('designactiv-motion') === 'off') document.documentElement.classList.add('motion-off');
          } catch (e) {}
        </script>
      )
    }

    {/* The two subsets every page actually uses: Geist for all the text, and
        the serif italic for the accent word in each page's headline, which is
        above the fold. Everything else is fetched only if a character needs it. */}
    <link
      rel="preload"
      href="/assets/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* The trial pages set no serif italic, so they skip its preload. */}
    {!themed && (
    <link
      rel="preload"
      href="/assets/fonts/source-serif-4-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DesignActiv" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Swap the no-js class before first paint so nothing flashes. The
        .reveal class arms the section entrances (site.js) only where they can
        run: motion allowed (by the system and by the footer's Animation
        switch) and IntersectionObserver present. If site.js has
        not taken over within 2.5s (blocked, failed, very slow), the class is
        dropped and every part shows, so content can never stay hidden. */}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches && !document.documentElement.classList.contains('motion-off')) {
        document.documentElement.classList.add('reveal');
        setTimeout(function () {
          if (!window.__revealReady) document.documentElement.classList.remove('reveal');
        }, 2500);
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} page={page} cta={themed} themeToggle={theme === 'switch'} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} motionToggle={themed} />
    <script src="/assets/js/site.js" defer is:inline></script>
  </body>
</html>

<style>
  main:focus-visible {
    outline: none;
  }
</style>
