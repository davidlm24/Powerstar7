---
/* Work, now the example sites (David, 2026-11-27): the blue page head, then
   four example sites for the kinds of small business the studio works with
   (src/data/examples.ts, drawn by ExampleSite.astro), one to a row of the
   grid, then this site as the team's own example with its evidence and
   measured figures, and the closing panel. The three client projects of the
   Powerstar7 years were here until David took them off the site (old, and
   some have moved on). The route stays /work (/pt/trabalhos); the nav calls
   it Examples.

   Each example is an exhibit row: the site in a plain browser window across
   three columns (the bar shows its made-up .example address), and in the
   fourth what kind of business it is, the feature it is built around, and
   what a site like it includes. Under 60rem the text drops under the
   window. */
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import PageTop from '../components/PageTop.astro';
import Pluses from '../components/Pluses.astro';
import ClosingPanel from '../components/ClosingPanel.astro';
import Glyph, { type GlyphName } from '../components/Glyph.astro';
import ExampleSite from '../components/ExampleSite.astro';
import { EXAMPLES, EXAMPLE_KEYS, EXAMPLE_META } from '../data/examples';
import { useTranslations, route, metrics, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The measured figures sit under their own "Technical details" label, dated,
   because a visitor cannot check them but a reader who wants proof can use them. */
const measuredOn = metrics.measuredAt
  ? new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(metrics.measuredAt))
  : '';

const hasFigures = metrics.measuredAt !== null && metrics.weightKb > 0;

/* Each claim about this site with the pixel glyph that says the same thing:
   a server for speed, the hand for ease of use, the refused cookie for no
   trackers, the browser window for a site where things are easy to find. */
const evidence: { g: GlyphName; text: string }[] = [
  { g: 'hosting', text: t('work.this.list.1') },
  { g: 'use', text: t('work.this.list.2') },
  { g: 'consent', text: t('work.this.list.3') },
  { g: 'web', text: t('work.this.list.4') },
];

/* The "+" marks: the rails always, an inner column line only where a cell
   edge in that section's first (top) or last (bottom) row meets the line. */
const PLUS = [0, 25, 50, 75, 100];
const EXHIBIT = [0, 75, 100];
const MID = [0, 50, 100];
---

<Base lang={lang} page="work" title={t('work.title')} description={t('work.lead')}>
  <Sheet>
    <PageTop title={t('work.h1')} lead={t('work.lead')} />

    {/* --- The example sites, one to a row ------------------------------ */}
    <section class="frame">
      <Pluses at={EXHIBIT} />
      <div class="grid">
        {
          EXAMPLE_KEYS.map((k) => {
            const ex = EXAMPLES[lang][k];
            return (
              <article class="row exhibit" id={k}>
                <div class="cell cell--flush span-3 exhibit__media">
                  <div class="exhibit__window">
                    {/* The bar is drawn: it frames the example as a website
                        and shows its made-up address. */}
                    <span class="exhibit__bar" aria-hidden="true">
                      <i></i>
                      <i></i>
                      <i></i>
                      <b>{EXAMPLE_META[k].host}</b>
                    </span>
                    <ExampleSite name={k} lang={lang} />
                  </div>
                </div>
                <div class="cell exhibit__text">
                  <h2 class="exhibit__name">{ex.type}</h2>
                  <p class="exhibit__tag">{t('examples.tag', { feature: ex.feature })}</p>
                  <p class="cell__b">{ex.line}</p>
                  <ul class="exhibit__list">
                    {ex.includes.map((item) => <li>{item}</li>)}
                  </ul>
                  <a class="exhibit__link" href={route('contact', lang)}>
                    {t('work.ex.cta')}
                    <span class="visually-hidden"> — {ex.type}</span>{' '}
                    <span class="exhibit__go" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
      <Pluses at={EXHIBIT} end />
    </section>

    {/* --- This site: the team's own example ------------------------------- */}
    <section class="frame" id="this">
      <Pluses at={MID} />
      <div class="grid">
        <div class="cell cell--head span-2 this__head">
          <p class="this__callout" aria-hidden="true">{t('work.callout')}</p>
          <h2 class="head__h">{t('work.this.h')}</h2>
        </div>
        <div class="cell cell--lead span-2">
          <p class="head__lead">{t('work.this.b')}</p>
        </div>

        <ul class="row">
          {
            evidence.map((e) => (
              <li class="cell" data-glyph-zone>
                <span class="cell__art">
                  <Glyph name={e.g} size={48} />
                </span>
                <p class="evidence__text">{e.text}</p>
              </li>
            ))
          }
        </ul>

        {
          hasFigures && (
            <div class="row figures">
              <p class="cell figures__label">
                {t('work.this.details')}
                <span class="figures__date">{t('work.this.measured', { date: measuredOn })}</span>
              </p>
              {/* display: contents, so each figure is a cell of the row. */}
              <dl class="figures__list">
                <div class="cell figure">
                  <dt>{t('home.proof.weight')}</dt>
                  <dd>
                    {metrics.weightKb}
                    <span>KB</span>
                  </dd>
                </div>
                <div class="cell figure">
                  <dt>{t('home.proof.requests')}</dt>
                  <dd>{metrics.requests}</dd>
                </div>
                <div class="cell figure">
                  <dt>{t('home.proof.thirdParty')}</dt>
                  <dd>{metrics.thirdPartyRequests}</dd>
                </div>
              </dl>
            </div>
          )
        }
      </div>
      <Pluses at={PLUS} narrow={[0, 50, 100]} end />
    </section>

    {/* The page ends straight on the closing panel: a separate "Have a
        project in mind?" section before it said the same thing twice
        (David, 2026-11-26). */}
    <ClosingPanel lang={lang} />
  </Sheet>

  <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) return;

      // Each glyph's pixels light up once, when its cell first comes into view.
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-play');
          io.unobserve(e.target);
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('[data-glyph-zone]').forEach(function (el) {
        io.observe(el);
        // Replay on hover or focus; the class stays until the wave has run,
        // so leaving early never cuts it off.
        var t = 0;
        var again = function (e) {
          if (e.type === 'pointerenter' && e.pointerType !== 'mouse') return;
          if (el.classList.contains('is-again')) return;
          el.classList.add('is-again');
          clearTimeout(t);
          t = setTimeout(function () { el.classList.remove('is-again'); }, 1100);
        };
        el.addEventListener('pointerenter', again);
        el.addEventListener('focusin', again);
      });
    })();
  </script>
</Base>

<style>
  /* The shared grid, panels and type live in src/styles/grid.css. */

  /* --- The example sites ------------------------------------------------------- */
  /* Home's stage links here, and its measured figures to #this;
     global.css's scroll-padding clears the header. */

  /* The faint wash from above, as on the home page's project cards: blue at
     10 %, gone by the screenshot's middle. */
  .exhibit__media {
    padding: var(--cell-pad) var(--cell-pad) 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent-fn) 10%, transparent), transparent 55%), var(--bg);
    align-content: end;
  }

  .exhibit__window {
    overflow: clip;
    border: 1px solid var(--rail);
    border-block-end: 0;
    border-start-start-radius: var(--radius);
    border-start-end-radius: var(--radius);
    background: var(--bg);
  }

  .exhibit__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.75rem;
    border-block-end: 1px solid var(--rail);
    font-size: var(--t-micro);
    color: var(--fg-muted);
  }

  .exhibit__bar i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--rail);
  }

  .exhibit__bar b {
    margin-inline-start: 6px;
    font-weight: var(--weight-text);
  }

  /* The name sits level with the browser bar beside it. */
  .exhibit__text {
    align-content: start;
  }

  .exhibit__name {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 500;
  }

  .exhibit__tag {
    font-size: var(--t-micro);
    color: var(--fg-muted);
  }

  /* What a site like it includes: the strip's small accent squares, no
     dividing lines (the house rule). */
  .exhibit__list {
    display: grid;
    gap: 0.45rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
    line-height: 1.4;
  }

  .exhibit__list li {
    display: grid;
    grid-template-columns: 5px 1fr;
    align-items: baseline;
    gap: 0.75rem;
  }

  .exhibit__list li::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    background: var(--accent-fn);
    transform: translateY(-0.15em);
  }

  .exhibit__link {
    justify-self: start;
    margin-block-start: 0.75rem;
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
    color: var(--accent-fn);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 200ms var(--ease);
  }

  .exhibit__link:hover,
  .exhibit__link:focus-visible {
    text-decoration-color: currentColor;
  }

  .exhibit__go {
    display: inline-block;
    transition: transform 220ms var(--ease);
  }

  .exhibit__link:hover .exhibit__go {
    transform: translateX(4px);
  }

  /* --- This site ---------------------------------------------------------------- */
  .this__head {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .this__callout {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--accent-fn);
  }

  .this__callout::before {
    content: '';
    display: inline-block;
    inline-size: 5px;
    block-size: 5px;
    margin-inline-end: 0.6rem;
    vertical-align: middle;
    background: var(--accent-fn);
  }

  .evidence__text {
    max-inline-size: 24ch;
    font-size: var(--t-body);
    line-height: 1.45;
  }

  /* The figures: a label cell, then one cell for each measured figure. */
  .figures__list {
    display: contents;
    margin: 0;
  }

  .figures__label {
    align-content: end;
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
  }

  .figures__date {
    display: block;
    font-weight: var(--weight-text);
    color: var(--fg-muted);
  }

  .figure {
    align-content: end;
  }

  .figure dt {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .figure dd {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .figure dd span {
    font-size: 0.45em;
    letter-spacing: 0;
    color: var(--fg-muted);
    margin-inline-start: 0.15em;
  }

  /* --- Narrower screens ----------------------------------------------------------- */
  @media (max-width: 60rem) {
    /* The text drops under the screenshot and takes the whole row. */
    .exhibit__text {
      grid-column: 1 / -1;
    }

    .this__head {
      min-block-size: 10rem;
    }
  }

  @media (max-width: 39.99rem) {
    .this__head {
      min-block-size: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exhibit__link,
    .exhibit__go {
      transition: none;
    }

    .exhibit__link:hover .exhibit__go {
      transform: none;
    }
  }
</style>
