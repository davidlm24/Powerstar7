---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import AsciiCallout from '../components/AsciiCallout.astro';
import Closing from '../components/Closing.astro';
import { useTranslations, metrics, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The measured figures sit under their own "Technical details" label, dated,
   because a visitor cannot check them but a reader who wants proof can use them. */
const measuredOn = metrics.measuredAt
  ? new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(metrics.measuredAt))
  : '';

const evidence = [
  t('work.this.list.1'),
  t('work.this.list.2'),
  t('work.this.list.3'),
  t('work.this.list.4'),
];
---

<Base lang={lang} page="work" title={t('work.title')} description={t('work.lead')}>
  <PageHead title={t('work.h1')} lead={t('work.lead')} figure="work" />

  {/* The site itself as the evidence, until client work can be shown. The
      old site put six tiles here labelled "Project 1" through "Project 6",
      pointing at six 2 KB images that were solid black. Showing real proof
      is worth more than a page that pretends.

      A block describing the first client project in build sat above this
      one. It was cut on 2026-10-08 until the client agrees to be shown; the
      markup and its work.case.* strings are in git history, in the commit
      that removed them. */}
  <div class="exhibits rails">
    <div class="container">
      {/* --- This site --------------------------------------------------- */}
      <article class="exhibit row row--statement">
        <header class="exhibit__head row__title">
          <h2 class="exhibit__h">{t('work.this.h')}</h2>
          <AsciiCallout text={t('work.callout')} />
        </header>

        <div class="exhibit__body row__body">
          <p class="lead">{t('work.this.b')}</p>

          <ul class="evidence">
            {evidence.map((item) => <li>{item}</li>)}
          </ul>

          {
            metrics.measuredAt !== null && metrics.weightKb > 0 && (
              <div class="details">
                <p class="details__h">
                  {t('work.this.details')} · {t('work.this.measured', { date: measuredOn })}
                </p>
              <dl class="figures">
                <div>
                  <dt>{t('home.proof.weight')}</dt>
                  <dd>
                    {metrics.weightKb}
                    <span>KB</span>
                  </dd>
                </div>
                <div>
                  <dt>{t('home.proof.requests')}</dt>
                  <dd>{metrics.requests}</dd>
                </div>
                <div>
                  <dt>{t('home.proof.thirdParty')}</dt>
                  <dd>{metrics.thirdPartyRequests}</dd>
                </div>
              </dl>
              </div>
            )
          }
        </div>
      </article>
    </div>
  </div>

  <section class="next rails">
    <div class="container next__inner">
      <h2 class="next__h">{t('work.next.h')}</h2>
      <p class="next__b measure">{t('work.next.b')}</p>
    </div>
  </section>

  <Closing lang={lang} />
</Base>

<style>
  .exhibit {
    padding-block: var(--s5) var(--s6);
  }

  .exhibit__h {
    margin-block-start: var(--s3);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.06;
  }

  .exhibit__body {
    display: grid;
    gap: var(--s4);
  }

  .exhibit__body .lead {
    max-width: var(--measure);
  }

  .evidence {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: var(--measure);
  }

  .evidence li {
    padding-block: 0.5rem;
    font-size: var(--t-body);
  }

  /* The same figures as the home page, at body scale — here they are
     supporting evidence rather than the headline. */
  .figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    margin: 0;
  }

  .figures dt {
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
  }

  .details {
    display: grid;
    gap: var(--s3);
    max-width: var(--measure);
    padding-block-start: var(--s4);
  }

  .details__h {
    margin: 0;
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
  }

  .figures dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    /* --weight-medium: the display weight is 400 now, and tabular figures at
       400 read as a placeholder rather than as a measured result. */
    font-weight: var(--weight-medium);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .figures dd span {
    font-size: 0.45em;
    color: var(--fg-muted);
    margin-inline-start: 0.15em;
  }

  .next {
    padding-block: var(--s5) 0;
  }

  .next__inner {
    display: grid;
    gap: var(--s3);
  }

  .next__h {
    font-size: var(--t-h3);
  }

  .next__b {
    color: var(--fg-muted);
  }

</style>
