---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { useTranslations, CONTACT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The validation strings travel to the client as data, so the errors are
   always in the language of the page being read. The browser's own
   reportValidity() would use the *browser's* locale instead — which is how
   a German visitor ended up reading German error text inside an English
   form on the old site. */
const formCopy = JSON.stringify({
  name: t('contact.err.name'),
  email: t('contact.err.email'),
  emailFormat: t('contact.err.emailFormat'),
  message: t('contact.err.message'),
  one: t('contact.err.one'),
  many: t('contact.err.many'),
  ok: t('contact.ok'),
  fail: t('contact.fail'),
  sending: t('contact.form.sending'),
  mailtoOpening: t('contact.mailtoOpening'),
  unconfigured: t('contact.unconfigured'),
});

const topics = [
  t('contact.form.topic.web'),
  t('contact.form.topic.brand'),
  t('contact.form.topic.seo'),
  t('contact.form.topic.email'),
  t('contact.form.topic.hosting'),
  t('contact.form.topic.other'),
];
---

<Base lang={lang} page="contact" title={t('contact.title')} description={t('contact.lead')}>
  <PageHead label={t('nav.contact')} title={t('contact.h1')} lead={t('contact.lead')} />

  <section class="contact rails">
    <div class="container contact__inner">
      {/* TODO before launch: set data-endpoint to the real form handler.
          Until then the form composes an email instead — and says that is
          what it is doing, rather than reporting a success it cannot know
          about (which is what the old site did). See DEPLOY.md. */}
      <form class="form" data-contact data-mailto={CONTACT.email} data-copy={formCopy} novalidate>
        <div class="field">
          <label for="name">{t('contact.form.name')}</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">{t('contact.form.email')}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="company">
            {t('contact.form.company')}
            <span class="field__hint">{t('contact.form.companyHint')}</span>
          </label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="topic">{t('contact.form.topic')}</label>
          <select id="topic" name="topic">
            {topics.map((topic) => <option value={topic}>{topic}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="message">{t('contact.form.message')}</label>
          <p class="field__hint" id="message-hint">{t('contact.form.messageHint')}</p>
          <textarea id="message" name="message" rows="6" aria-describedby="message-hint" required
          ></textarea>
        </div>

        {/* Honeypot. Hidden from sight and from assistive technology, so no
            real visitor is ever asked to leave a field empty. */}
        <div class="trap" aria-hidden="true">
          <label for="website">{t('contact.form.trap')}</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form__foot">
          <button class="btn" type="submit">{t('contact.form.submit')}</button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="direct">
        <h2 class="direct__h">{t('contact.direct.h')}</h2>
        <p class="direct__b">{t('contact.direct.b')}</p>
        <a class="direct__email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <p class="direct__note">{t('site.tagline')}</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-block-end: var(--section-y);
  }

  /* Not the 1-and-3 the other split sections use: at 961px a single column is
     208px, and --s4 of card padding leaves less than the email address needs.
     Two and two puts the divider on the centre line and gives the aside room. */
  .contact__inner {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: 0;
    row-gap: var(--s6);
    align-items: start;
    padding-block-start: var(--s5);
    border-top: 1px solid var(--rule);
  }

  /* span, not `1 / 3`: a numbered end line breaks when the column count drops
     — `3 / -1` on a two-column grid resolves to `3 / 3`, which the spec
     rewrites as an implicit extra track. span degrades on its own, so the
     layout no longer depends on a media query firing at the right width. */
  .form {
    grid-column: span 2;
    padding-inline-end: var(--s5);
  }

  /* The aside is a COLUMN now, not a card. As a card its own border sat 48px
     off the grid line — the margin had already pushed it in — so a divider on
     the column boundary meant two lines 48px apart. Dropping the card lets the
     divider be the separation, exactly on the line. */
  .direct {
    grid-column: span 2;
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: var(--s6);
  }

  /* --- Form -------------------------------------------------------------- */

  .form {
    display: grid;
    gap: var(--s4);
    max-width: 36rem;
  }


  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
  }

  .field__hint {
    font-size: var(--t-small);
    font-weight: var(--weight-text);
    color: var(--fg-muted);
  }

  label .field__hint {
    margin-inline-start: 0.4em;
  }

  /* 1rem = 18px here, comfortably above the 16px below which iOS Safari
     zooms the viewport on focus. */
  .field input,
  .field select,
  .field textarea {
    inline-size: 100%;
    padding: 0.7rem 0.8rem;
    font-size: 1rem;
    background: var(--paper-hi);
    color: var(--fg);
    /* --field-edge, not --rule. This is a control boundary, which WCAG 1.4.11
       holds to 3:1; --rule is 1.084:1 and left the inputs effectively
       invisible, since --paper-hi is only 1.046:1 against the ground as well.
       See tokens.css for why the fix is a second token rather than a heavier
       --rule. */
    border: 1px solid var(--field-edge);
  }

  .field textarea {
    resize: vertical;
    min-block-size: 8rem;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--blue);
  }

  .field :global([aria-invalid='true']) {
    border-color: var(--error);
  }

  .field :global(.field__error) {
    color: var(--error);
    font-size: var(--t-small);
  }

  .trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
  }

  .form__status {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .form__status[data-kind='error'] {
    color: var(--error);
  }

  .form__status[data-kind='ok'] {
    color: var(--accent-fn);
  }

  /* --- Direct ------------------------------------------------------------ */



  .direct__h {
    font-size: 1.25rem;
  }

  .direct__b {
    margin-block-start: var(--s2);
    color: var(--fg-muted);
    font-size: var(--t-small);
  }

  .direct__email {
    display: inline-block;
    margin-block-start: var(--s3);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
  }

  .direct__note {
    margin-block-start: var(--s4);
    padding-block-start: var(--s3);
    border-top: 1px solid var(--rule);
    font-size: var(--t-micro);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @media (max-width: 60rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr);
      /* Halved, because the divider below now sits in this gap and wants equal
         air on both sides rather than all of it above. */
      row-gap: var(--s5);
    }

    .form {
      padding-inline: 0;
    }

    /* The column divider becomes a ROW divider rather than disappearing. These
       are two different things — the form, and the ways to reach a person
       directly — and when they stop being side by side they still need telling
       apart. Previously the border was simply reset to 0 here and nothing took
       its place, so the two ran together as one column of text. */
    .direct {
      border-inline-start: 0;
      padding-inline-start: 0;
      border-top: 1px solid var(--rule);
      padding-block-start: var(--s5);
    }
  }
</style>
