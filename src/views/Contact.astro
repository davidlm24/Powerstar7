---
/* Contact (the 2026-11 redesign, rolled out 2026-11-26). The page head is
   the blue panel every inner page opens with (PageTop); under it, one
   section of the grid: the form in the left half, the ways to reach a person
   directly in the right half, with the email glyph above them. There is no
   closing panel: its link would point at this page.

   Everything site.js reads is kept: form[data-contact] with data-mailto and
   data-copy, the field ids and names, the honeypot input[name="website"],
   .form__status and the submit button. The grid keeps the contact__inner
   class so its cells enter with the section entrances (global.css). */
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import PageTop from '../components/PageTop.astro';
import Pluses from '../components/Pluses.astro';
import Glyph from '../components/Glyph.astro';
import { useTranslations, route, CONTACT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The validation strings travel to the client as data, so the errors are
   always in the language of the page being read. The browser's own
   reportValidity() would use the *browser's* locale instead — which is how
   a German visitor ended up reading German error text inside an English
   form on the old site. */
const formCopy = JSON.stringify({
  name: t('contact.err.name'),
  email: t('contact.err.email'),
  emailFormat: t('contact.err.emailFormat'),
  message: t('contact.err.message'),
  one: t('contact.err.one'),
  many: t('contact.err.many'),
  ok: t('contact.ok'),
  fail: t('contact.fail'),
  sending: t('contact.form.sending'),
  mailtoOpening: t('contact.mailtoOpening'),
  subject: t('contact.mailSubject'),
  unconfigured: t('contact.unconfigured'),
});

/* What someone is choosing between, in the same names the Services page
   prices them under: the project, the care plan, the add-ons. Not one
   option per discipline — that was the old five-service menu, and it asked
   a visitor to know whether their problem was "SEO" before they had
   written a word. */
const topics = [
  t('contact.form.topic.website'),
  t('contact.form.topic.care'),
  t('contact.form.topic.extras'),
  t('contact.form.topic.other'),
];

/* The section is one row of two half-width cells, so its top and bottom
   lines are crossed by the rails and the centre line only. */
const MID = [0, 50, 100];
---

<Base lang={lang} page="contact" title={t('contact.title')} description={t('contact.lead')}>
  <Sheet>
    <PageTop title={t('contact.h1')} lead={t('contact.lead')} />

    <section class="frame frame--last">
      <Pluses at={MID} />
      <div class="grid contact__inner">
        <div class="cell span-2 cell--form">
          {/* TODO before launch: set data-endpoint to the real form handler.
              Until then the form composes an email instead — and says that is
              what it is doing, rather than reporting a success it cannot know
              about (which is what the old site did). See DEPLOY.md. */}
          {/* method="post": with JavaScript off a form without a method submits
              a GET, which put the visitor's name, email and message into the
              URL (history, server logs). novalidate is set by site.js, so the
              browser's own validation stays on when the script is not there.
              The <noscript> block below hides the button and offers the email. */}
          <form class="form" method="post" data-contact data-mailto={CONTACT.email} data-copy={formCopy}>
            <div class="field">
              <label for="name">{t('contact.form.name')}</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="email">{t('contact.form.email')}</label>
              <input id="email" name="email" type="email" autocomplete="email" spellcheck="false" required />
            </div>

            <div class="field">
              <label for="company">
                {t('contact.form.company')}
                <span class="field__hint">{t('contact.form.companyHint')}</span>
              </label>
              <input id="company" name="company" type="text" autocomplete="organization" />
            </div>

            <div class="field">
              <label for="topic">{t('contact.form.topic')}</label>
              <select id="topic" name="topic">
                {topics.map((topic) => <option value={topic}>{topic}</option>)}
              </select>
            </div>

            <div class="field">
              <label for="message">{t('contact.form.message')}</label>
              <p class="field__hint" id="message-hint">{t('contact.form.messageHint')}</p>
              <textarea id="message" name="message" rows="6" aria-describedby="message-hint" required
              ></textarea>
              {/* The old ASCII aside, now a quiet note under the box. It only
                  repeats the hint above, so it stays hidden from assistive
                  technology as before. */}
              <p class="field__aside" aria-hidden="true">{t('contact.callout')}</p>
            </div>

            {/* Honeypot. Hidden from sight and from assistive technology, so no
                real visitor is ever asked to leave a field empty. */}
            <div class="trap" aria-hidden="true">
              <label for="website">{t('contact.form.trap')}</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <p class="form__privacy">
              {t('contact.form.privacy')} <a href={route('privacy', lang)}>{t('contact.form.privacyLink')}</a>
            </p>

            <noscript>
              <style>
                .form__foot .btn {
                  display: none;
                }
              </style>
              <p class="form__noscript">
                {t('contact.form.noscript')} <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              </p>
            </noscript>

            <div class="form__foot">
              <button class="btn" type="submit">{t('contact.form.submit')}</button>
              <p class="form__status" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>

        {/* The ways to reach a person, in their own cell: the email at the
            size of a heading, since for many visitors it is the whole page. */}
        <aside class="cell span-2 direct" data-glyph-zone>
          <span class="cell__art" aria-hidden="true"><Glyph name="email" size={96} /></span>
          <h2 class="head__h head__h--sm">{t('contact.direct.h')}</h2>
          <p class="cell__b direct__b">{t('contact.direct.b')}</p>
          <a class="direct__email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          {
            CONTACT.whatsapp && (
              <a class="direct__alt" href={`https://wa.me/${CONTACT.whatsapp}`}>{t('contact.direct.whatsapp')}</a>
            )
          }
          {
            CONTACT.phone && (
              <a class="direct__alt" href={`tel:${CONTACT.phone.replace(/s/g, '')}`}>{t('contact.direct.phone')}: {CONTACT.phone}</a>
            )
          }
        </aside>
      </div>
      <Pluses at={MID} end />
    </section>
  </Sheet>

  <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) return;

      // The glyph's pixels light up once, when the glyph itself first comes
      // into view. The glyph is watched rather than its cell: the cell runs
      // as tall as the form beside it, often taller than the screen.
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var zone = e.target.closest('[data-glyph-zone]');
          if (zone) zone.classList.add('is-play');
          io.unobserve(e.target);
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('[data-glyph-zone]').forEach(function (el) {
        io.observe(el.querySelector('.glyph') || el);
        // Replay on hover or focus; the class stays until the wave has run
        // (560ms + 22 diagonals x 22ms), so leaving early never cuts it off.
        var t = 0;
        var again = function (e) {
          if (e.type === 'pointerenter' && e.pointerType !== 'mouse') return;
          if (el.classList.contains('is-again')) return;
          el.classList.add('is-again');
          clearTimeout(t);
          t = setTimeout(function () { el.classList.remove('is-again'); }, 1100);
        };
        el.addEventListener('pointerenter', again);
        el.addEventListener('focusin', again);
      });
    })();
  </script>
</Base>

<style>
  /* The shared grid and panels live in src/styles/grid.css. */

  /* With no closing panel, the last section keeps the gap before the footer
     itself; the rails run on through it. A margin, not padding: the end
     marks sit on the frame's bottom edge, which must stay the grid's line. */
  .frame--last {
    margin-block-end: var(--section-gap);
  }

  /* --- Form -------------------------------------------------------------- */

  .form {
    position: relative;
    display: grid;
    gap: var(--s4);
    max-inline-size: 36rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
    color: var(--fg);
  }

  .field__hint {
    font-size: var(--t-small);
    font-weight: var(--weight-text);
    color: var(--fg-muted);
  }

  label .field__hint {
    margin-inline-start: 0.4em;
  }

  .field__aside {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--fg-muted);
  }

  /* 1rem = 18px here, comfortably above the 16px below which iOS Safari
     zooms the viewport on focus. */
  .field input,
  .field select,
  .field textarea {
    inline-size: 100%;
    padding: 0.7rem 0.8rem;
    font: inherit;
    font-size: 1rem;
    background: var(--paper-hi);
    color: var(--fg);
    /* --field-edge, not --rail: this is a control boundary, which WCAG 1.4.11
       holds to 3:1 against what is around it, in both themes (themes.css). */
    border: 1px solid var(--field-edge);
    border-radius: var(--radius-sm);
  }

  .field textarea {
    resize: vertical;
    min-block-size: 8rem;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--accent-fn);
  }

  /* Element + attribute, so it outranks the base border rule above (the
     :global version lost on specificity: review A5). After :focus-visible,
     so a focused invalid field stays red. */
  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--error);
  }

  .field :global(.field__error) {
    color: var(--error);
    font-size: var(--t-small);
  }

  .trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-block-start: var(--s2);
  }

  .form__privacy,
  .form__noscript {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .form__privacy a,
  .form__noscript a {
    color: var(--accent-fn);
    text-underline-offset: 3px;
  }

  .form__status {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .form__status[data-kind='error'] {
    color: var(--error);
  }

  .form__status[data-kind='ok'] {
    color: var(--accent-fn);
  }

  /* --- Direct ------------------------------------------------------------ */

  .direct {
    gap: var(--s3);
  }

  .direct__b {
    max-inline-size: 40ch;
  }

  .direct__email {
    justify-self: start;
    margin-block-start: var(--s2);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
    color: var(--accent-fn);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .direct__email:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .direct__alt {
    justify-self: start;
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
    color: var(--accent-fn);
  }
</style>
