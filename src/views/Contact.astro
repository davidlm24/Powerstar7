---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import AsciiCallout from '../components/AsciiCallout.astro';
import { useTranslations, route, CONTACT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The validation strings travel to the client as data, so the errors are
   always in the language of the page being read. The browser's own
   reportValidity() would use the *browser's* locale instead — which is how
   a German visitor ended up reading German error text inside an English
   form on the old site. */
const formCopy = JSON.stringify({
  name: t('contact.err.name'),
  email: t('contact.err.email'),
  emailFormat: t('contact.err.emailFormat'),
  message: t('contact.err.message'),
  one: t('contact.err.one'),
  many: t('contact.err.many'),
  ok: t('contact.ok'),
  fail: t('contact.fail'),
  sending: t('contact.form.sending'),
  mailtoOpening: t('contact.mailtoOpening'),
  subject: t('contact.mailSubject'),
  unconfigured: t('contact.unconfigured'),
});

/* What someone is choosing between, in the same names the Services page
   prices them under: the project, the care plan, the add-ons. Not one
   option per discipline — that was the old five-service menu, and it asked
   a visitor to know whether their problem was "SEO" before they had
   written a word. */
const topics = [
  t('contact.form.topic.website'),
  t('contact.form.topic.care'),
  t('contact.form.topic.extras'),
  t('contact.form.topic.other'),
];
---

<Base lang={lang} page="contact" title={t('contact.title')} description={t('contact.lead')}>
  <PageHead title={t('contact.h1')} lead={t('contact.lead')} figure="contact" cursor />

  <section class="contact rails">
    <div class="container contact__inner">
      {/* TODO before launch: set data-endpoint to the real form handler.
          Until then the form composes an email instead — and says that is
          what it is doing, rather than reporting a success it cannot know
          about (which is what the old site did). See DEPLOY.md. */}
      <form class="form" data-contact data-mailto={CONTACT.email} data-copy={formCopy} novalidate>
        <div class="field">
          <label for="name">{t('contact.form.name')}</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">{t('contact.form.email')}</label>
          <input id="email" name="email" type="email" autocomplete="email" spellcheck="false" required />
        </div>

        <div class="field">
          <label for="company">
            {t('contact.form.company')}
            <span class="field__hint">{t('contact.form.companyHint')}</span>
          </label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="topic">{t('contact.form.topic')}</label>
          <select id="topic" name="topic">
            {topics.map((topic) => <option value={topic}>{topic}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="message">{t('contact.form.message')}</label>
          <p class="field__hint" id="message-hint">{t('contact.form.messageHint')}</p>
          <textarea id="message" name="message" rows="6" aria-describedby="message-hint" required
          ></textarea>
          <AsciiCallout text={t('contact.callout')} />
        </div>

        {/* Honeypot. Hidden from sight and from assistive technology, so no
            real visitor is ever asked to leave a field empty. */}
        <div class="trap" aria-hidden="true">
          <label for="website">{t('contact.form.trap')}</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form__privacy">
          {t('contact.form.privacy')} <a href={route('privacy', lang)}>{t('contact.form.privacyLink')}</a>
        </p>

        <div class="form__foot">
          <button class="btn" type="submit">{t('contact.form.submit')}</button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </div>
      </form>

      {/* One picture per page: the speech bubbles in the page head. The
          envelope that sat here was a second one (David, 2026-10-16). */}
      <aside class="direct">
        <h2 class="direct__h">{t('contact.direct.h')}</h2>
        <p class="direct__b">{t('contact.direct.b')}</p>
        <a class="direct__email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        {
          CONTACT.whatsapp && (
            <a class="direct__alt" href={`https://wa.me/${CONTACT.whatsapp}`}>{t('contact.direct.whatsapp')}</a>
          )
        }
        {
          CONTACT.phone && (
            <a class="direct__alt" href={`tel:${CONTACT.phone.replace(/s/g, '')}`}>{t('contact.direct.phone')}: {CONTACT.phone}</a>
          )
        }
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-block-end: var(--section-y);
  }

  /* Not the 1-and-3 the other split sections use: at 961px a single column is
     208px, and --s4 of card padding leaves less than the email address needs.
     Two and two puts the divider on the centre line and gives the aside room. */
  .contact__inner {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: 0;
    row-gap: var(--s6);
    align-items: start;
  }

  /* span, not `1 / 3`: a numbered end line breaks when the column count drops
     — `3 / -1` on a two-column grid resolves to `3 / 3`, which the spec
     rewrites as an implicit extra track. span degrades on its own, so the
     layout no longer depends on a media query firing at the right width. */
  /* --col-pad on both sides of the divider, matching .direct below. It was
     --s5 here against --s6 there: 16px apart below 1280, and the sign FLIPS
     above 1440, where .form's own max-width caps it short of its track and
     leaves this padding dead code while the aside keeps its 64px. */
  /* The corner, as on the pricing cards (Services.astro): blue dots falling
     off from the form's top-right corner, denser and nearer on hover. The
     first field's own paper fill sits over most of it; the rest shows in
     the gaps between fields, where there is no text. */
  @supports (mask-image: url('')) or (-webkit-mask-image: url('')) {
    .form::after {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: 0;
      z-index: -1;
      inline-size: 240px;
      block-size: 200px;
      pointer-events: none;
      background: var(--accent-fn);
      mask-image: image-set(url('/assets/dither/corner.png') 1x, url('/assets/dither/corner@2x.png') 2x);
      -webkit-mask-image: image-set(url('/assets/dither/corner.png') 1x, url('/assets/dither/corner@2x.png') 2x);
      mask-size: 240px 200px;
      -webkit-mask-size: 240px 200px;
      mask-repeat: no-repeat;
      -webkit-mask-repeat: no-repeat;
      transition: translate var(--dur) var(--ease);
    }

    /* .is-sent (site.js, once the message went): the corner steps dense
       and stays, the same move it makes for the pointer, now meaning
       "received", while the reply under the button prints in dots. */
    .form:hover::after,
    .form:focus-within::after,
    .form.is-sent::after {
      translate: 2px -2px;
      mask-image: image-set(url('/assets/dither/corner-hi.png') 1x, url('/assets/dither/corner-hi@2x.png') 2x);
      -webkit-mask-image: image-set(url('/assets/dither/corner-hi.png') 1x, url('/assets/dither/corner-hi@2x.png') 2x);
    }

    @media (max-width: 40rem) {
      .form::after { display: none; }
    }
  }

  .form {
    position: relative;
    isolation: isolate;
    grid-column: span 2;
    padding-inline-end: var(--col-pad);
  }

  /* The aside is a COLUMN now, not a card. As a card its own border sat 48px
     off the grid line — the margin had already pushed it in — so a divider on
     the column boundary meant two lines 48px apart. Dropping the card lets the
     divider be the separation, exactly on the line. */
  .direct {
    grid-column: span 2;
    padding-inline-start: var(--col-pad);
  }

  /* --- Form -------------------------------------------------------------- */

  .form {
    display: grid;
    gap: var(--s4);
    max-width: 36rem;
  }


  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
  }

  .field__hint {
    font-size: var(--t-small);
    font-weight: var(--weight-text);
    color: var(--fg-muted);
  }

  label .field__hint {
    margin-inline-start: 0.4em;
  }

  /* 1rem = 18px here, comfortably above the 16px below which iOS Safari
     zooms the viewport on focus. */
  .field input,
  .field select,
  .field textarea {
    inline-size: 100%;
    padding: 0.7rem 0.8rem;
    font-size: 1rem;
    background: var(--paper-hi);
    color: var(--fg);
    /* --field-edge, not --rule. This is a control boundary, which WCAG 1.4.11
       holds to 3:1; --rule is 1.084:1 and left the inputs effectively
       invisible, since --paper-hi is only 1.046:1 against the ground as well.
       See tokens.css for why the fix is a second token rather than a heavier
       --rule. */
    border: 1px solid var(--field-edge);
  }

  .field textarea {
    resize: vertical;
    min-block-size: 8rem;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--blue);
  }

  .field :global([aria-invalid='true']) {
    border-color: var(--error);
  }

  .field :global(.field__error) {
    color: var(--error);
    font-size: var(--t-small);
  }

  .trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
  }

  .form__privacy {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .form__status {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .form__status[data-kind='error'] {
    color: var(--error);
  }

  .form__status[data-kind='ok'] {
    color: var(--accent-fn);
  }

  /* --- Direct ------------------------------------------------------------ */



  .direct__h {
    font-size: 1.25rem;
  }

  .direct__b {
    margin-block-start: var(--s2);
    color: var(--fg-muted);
    font-size: var(--t-small);
  }

  .direct__email {
    display: inline-block;
    margin-block-start: var(--s3);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
  }

  .direct__alt {
    display: block;
    margin-block-start: var(--s2);
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 60rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr);
      /* Halved, because the divider below now sits in this gap and wants equal
         air on both sides rather than all of it above. */
      row-gap: var(--s5);
    }

    .form {
      padding-inline: 0;
    }

    /* The column divider becomes a ROW divider rather than disappearing. These
       are two different things — the form, and the ways to reach a person
       directly — and when they stop being side by side they still need telling
       apart. Previously the border was simply reset to 0 here and nothing took
       its place, so the two ran together as one column of text. */
    .direct {
      border-inline-start: 0;
      padding-inline-start: 0;
      padding-block-start: var(--s5);
    }
  }
</style>
