---
/* Pricing (the 2026-11 redesign; trial on /lab/pricing-dark, rolled out
   2026-11-26). One offer and the plan that follows it, then the extras and
   the questions about money. Figures come from src/data/pricing.ts as
   §amount§ markers drawn by <Priced> (euros, with reais for the currency
   toggle), so a price changes in one place and a string never holds one.

   The blue project card is the pricing card with the shine in its corner
   (David): HeroPixels variant="corner" at its top right, away from the
   price and the list. Its gradient ends darker (.panel__light--even): its
   text runs the card's full width. */
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import PageTop from '../components/PageTop.astro';
import Pluses from '../components/Pluses.astro';
import Faq from '../components/Faq.astro';
import ClosingPanel from '../components/ClosingPanel.astro';
import Accent from '../components/Accent.astro';
import Priced from '../components/Priced.astro';
import HeroPixels from '../components/HeroPixels.astro';
import { useTranslations, route, type Lang } from '../i18n/ui';
import { PRICING } from '../data/pricing';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const eur = (amount: number) => `§${amount}§`;
const from = (amount: number) => `${t('services.pricing.from')} ${eur(amount)}`;

const designIncludes = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => t(`services.design.i${n}` as 'services.design.i1'));
const careIncludes = [1, 2, 3, 4, 5, 6].map((n) => t(`services.care.i${n}` as 'services.care.i1'));

const addons = [
  { name: t('services.addons.pages'), price: t('services.pricing.perPage', { price: eur(PRICING.addons.page) }) },
  { name: t('services.addons.language'), price: from(PRICING.addons.language) },
  { name: t('services.addons.identity'), price: from(PRICING.addons.identity) },
  { name: t('services.addons.brand'), price: from(PRICING.addons.brand) },
  { name: t('services.addons.email'), price: from(PRICING.addons.email) },
  { name: t('services.addons.automation'), price: from(PRICING.addons.automation) },
];

const faqs = [
  { q: t('services.faq.q1'), a: t('services.faq.a1') },
  { q: t('services.faq.q4'), a: t('services.faq.a4') },
  { q: t('services.faq.q5'), a: t('services.faq.a5', { price: eur(PRICING.addons.language) }) },
  { q: t('services.faq.q7'), a: t('services.faq.a7', { price: eur(PRICING.care) }) },
];

const MID = [0, 50, 100];
---

<Base lang={lang} page="pricing" title={t('pricing.title')} description={t('pricing.lead')}>
  <Sheet>
    <PageTop title={t('pricing.h1')} lead={t('pricing.lead')} />

    {/* --- What things cost ------------------------------------------------- */}
    <section class="frame" id="pricing">
      <Pluses at={MID} />
      <div class="grid">
        <div class="cell cell--head span-2">
          <h2 class="head__h"><Accent text={t('services.pricing.h2')} /></h2>
        </div>
        <div class="cell cell--lead span-2">
          <p class="head__lead">{t('services.pricing.lead')}</p>
          {/* Shown by site.js, so it never appears where it would do nothing. */}
          <div class="currency" data-currency hidden role="group" aria-label={t('services.currency.label')}>
            <span class="currency__label" aria-hidden="true">{t('services.currency.label')}</span>
            <span class="currency__btns">
              <button type="button" class="currency__btn" data-cur="eur" aria-pressed="true">EUR · €</button>
              <button type="button" class="currency__btn" data-cur="brl" aria-pressed="false">BRL · R$</button>
            </span>
          </div>
          <p class="currency__note" data-currency-note role="status" hidden>
            {t('services.currency.note')}
          </p>
        </div>

        <article class="cell plan plan--design panel on-blue span-2">
          <div class="panel__light panel__light--even" aria-hidden="true"></div>
          <HeroPixels variant="corner" focus="1 0" />
          <div class="plan__body">
            <p class="plan__kind">{t('services.design.kind')}</p>
            <h3 class="plan__name">{t('services.design.name')}</h3>
            {/* One line, a real space between the spans (Astro's HTML
                compression would otherwise leave "From€750" in the text). */}
            <p class="plan__price">
              <span class="plan__unit">{t('services.pricing.from')}</span> <span class="plan__amount"><Priced text={eur(PRICING.design)} lang={lang} /></span>
            </p>
            <p class="plan__note">{t('services.design.note')}</p>
            <h4 class="plan__includes">{t('services.pricing.includes')}</h4>
            <ul class="plan__list plan__list--two">
              {designIncludes.map((item) => <li>{item}</li>)}
            </ul>
            <a class="btn plan__cta" href={route('contact', lang)}>{t('home.cta')}</a>
          </div>
        </article>

        <article class="cell plan plan--care span-2">
          <div class="plan__body">
            <p class="plan__kind">{t('services.care.kind')}</p>
            <h3 class="plan__name">{t('services.care.name')}</h3>
            <p class="plan__price">
              <span class="plan__amount"><Priced text={eur(PRICING.care)} lang={lang} /></span> <span class="plan__unit">{t('services.pricing.perMonth')}</span>
            </p>
            <p class="plan__note">{t('services.care.note')}</p>
            <h4 class="plan__includes">{t('services.pricing.includes')}</h4>
            <ul class="plan__list">
              {careIncludes.map((item) => <li>{item}</li>)}
            </ul>
            <p class="plan__note">{t('services.care.small')}</p>
            <a class="btn btn--quiet plan__cta" href={route('contact', lang)}>{t('services.care.cta')}</a>
          </div>
        </article>
      </div>
      <Pluses at={MID} end />
    </section>

    {/* --- Extras ---------------------------------------------------------- */}
    <section class="frame">
      <Pluses at={MID} />
      <div class="grid">
        <div class="cell cell--head span-2">
          <h2 class="head__h head__h--sm">{t('services.addons.h')}</h2>
          <p class="head__lead">{t('services.addons.lead')}</p>
        </div>
        <div class="cell span-2 cell--list">
          <dl class="addons__list">
            {
              addons.map((a) => (
                <div class="addon">
                  <dt>{a.name}</dt>
                  <dd class="addon__price"><Priced text={a.price} lang={lang} /></dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <Pluses at={MID} end />
    </section>

    <Faq lang={lang} heading={t('pricing.faq.h2')} items={faqs} />

    <ClosingPanel lang={lang} />
  </Sheet>
</Base>


<style>
  /* The shared grid, panels and questions live in src/styles/grid.css. */

  /* --- Currency toggle --------------------------------------------------------- */
  .currency {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
  }

  .currency[hidden],
  .currency__note[hidden] { display: none; }

  .currency__label {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .currency__btns { display: inline-flex; }

  .currency__btn {
    min-block-size: 2.5rem;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
    background: var(--paper-hi);
    color: var(--fg);
    border: 1px solid var(--field-edge);
    cursor: pointer;
  }

  .currency__btn + .currency__btn { margin-inline-start: -1px; }

  .currency__btn:first-child {
    border-start-start-radius: var(--radius-sm);
    border-end-start-radius: var(--radius-sm);
  }

  .currency__btn:last-child {
    border-start-end-radius: var(--radius-sm);
    border-end-end-radius: var(--radius-sm);
  }

  .currency__btn:hover { background: var(--blue-wash); }

  .currency__btn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .currency__note {
    max-inline-size: 52ch;
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  /* --- The two plans ------------------------------------------------------------ */
  .plan {
    isolation: isolate;
    overflow: clip;
    padding: 0;
  }

  .plan__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    block-size: 100%;
    padding: clamp(var(--s4), 3vw, var(--s5));
  }

  /* The shine on the blue card: top right, gone before the list's second
     column (measured). */
  .plan--design :global(.hero-px--corner) {
    -webkit-mask-image: radial-gradient(ellipse 48% 42% at 100% 0%, #000 12%, rgb(0 0 0 / 0.3) 38%, transparent 72%);
    mask-image: radial-gradient(ellipse 48% 42% at 100% 0%, #000 12%, rgb(0 0 0 / 0.3) 38%, transparent 72%);
  }

  .plan__kind {
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    color: var(--fg-muted);
  }

  .plan__name {
    font-size: var(--t-h3);
    line-height: 1.15;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s1) var(--s2);
  }

  .plan__amount {
    font-size: var(--t-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tr-display);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .plan__unit {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .plan__note {
    max-inline-size: 52ch;
    font-size: var(--t-body);
    color: var(--fg-muted);
  }

  .plan__includes {
    margin-block-start: var(--s3);
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    color: var(--fg-muted);
  }

  .plan__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .plan__list--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s4);
  }

  .plan__list li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: var(--t-body);
  }

  .plan__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.15rem;
    inset-block-start: 0.3em;
    inline-size: 0.38rem;
    block-size: 0.7rem;
    border: solid var(--accent-fn);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .plan__cta {
    align-self: flex-start;
    margin-block-start: auto;
  }

  @media (max-width: 39.99rem) {
    .plan__list--two { grid-template-columns: minmax(0, 1fr); }
  }

  /* --- Extras --------------------------------------------------------------------- */
  .cell--list { align-content: center; }

  .cell--lead { gap: 1.25rem; }

  .addons__list { margin: 0; display: grid; }

  .addon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s1) var(--s3);
    padding-block: 0.8rem;
    border-block-end: 1px solid var(--rail);
  }

  .addon:first-child { padding-block-start: 0; }

  .addon:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .addon dt { font-weight: var(--weight-medium); }

  .addon__price {
    margin: 0;
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

</style>
