---
import Base from '../layouts/Base.astro';
import Illo from '../components/Illo.astro';
import AsciiCallout from '../components/AsciiCallout.astro';
import AsciiDivider from '../components/AsciiDivider.astro';
import Closing from '../components/Closing.astro';
import { useTranslations, route, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The lane bodies reuse svc.*.body — the same descriptions the Services page
   carries. Not a shortcut: they are already written, already translated, and
   already reviewed, and a home page carrying five placeholder strings would be
   worse than one carrying five real sentences. Swap in shorter dedicated keys
   if these read long in a lane.

   Written out rather than built with a template literal, because
   t(`svc.${key}.body`) needs an `as any` cast and that quietly removes the
   type protection from every key it touches. */
const services = [
  { n: '01', key: 'web', name: t('svc.web.name'), b: t('svc.web.body') },
  { n: '02', key: 'brand', name: t('svc.brand.name'), b: t('svc.brand.body') },
  { n: '03', key: 'seo', name: t('svc.seo.name'), b: t('svc.seo.body') },
  { n: '04', key: 'email', name: t('svc.email.name'), b: t('svc.email.body') },
  { n: '05', key: 'hosting', name: t('svc.hosting.name'), b: t('svc.hosting.body') },
] as const;

/* The headline's highlighted word is its last one (home.h1.mark), split off
   here so the copy stays one sentence in ui.ts. A mark that is not the end
   of the headline is a copy error, so the build stops on it rather than
   shipping a headline with nothing highlighted. */
const h1 = t('home.h1').replace(/\.$/, '');
const mark = t('home.h1.mark');
if (!h1.endsWith(mark)) {
  throw new Error(`home.h1.mark "${mark}" is not the last word of home.h1 (${lang})`);
}
const h1Lead = h1.slice(0, -mark.length).trimEnd();

/* The band along the foot of the hero. The first copy is the one screen
   readers get; the other three only keep the loop seamless, because half
   the track has to be wider than the widest screen for translateX(-50%) to
   come back round without a gap. */
const band = t('home.band.items').split(',').map((s) => s.trim());
const bandRun = [0, 1, 2, 3].flatMap((copy) => band.map((item) => ({ item, copy })));

/* Each step restates a commitment the site already makes elsewhere: a
   written scope with the price attached (About), design reviewed on real
   devices (Services), code with no builder underneath and WCAG AA as the
   floor (Services), and a handover in the client's name with a written guide
   (the position section). So nothing here claims anything new. The
   descriptions are drafts, written 2026-09-24; rewrite them freely. */
const steps = [
  { h: t('home.process.s1.h'), b: t('home.process.s1.b') },
  { h: t('home.process.s2.h'), b: t('home.process.s2.b') },
  { h: t('home.process.s3.h'), b: t('home.process.s3.b') },
  { h: t('home.process.s4.h'), b: t('home.process.s4.b') },
];

const position = [
  { h: t('home.position.one.h'), b: t('home.position.one.b') },
  { h: t('home.position.two.h'), b: t('home.position.two.b') },
  { h: t('home.position.three.h'), b: t('home.position.three.b') },
];
---

<Base lang={lang} page="home" title={t('home.title')}>
  {/* --- Hero ------------------------------------------------------------
      David's picks (2026-10-14): "Your website, sorted." with the last word
      highlighted; beside it one general picture, a laptop and a phone
      showing a site with a plant beside them (illustration D, "mix A + B",
      so it fits any kind of client and does not repeat the service icons
      below); and a slow band of the kinds of business we make sites for
      along the foot. On load the picture lands, the check seal is stamped
      on it, then the highlight fills. After that nothing moves but the
      band. */}
  <section class="hero rails">
    {/* Both decorative layers live on this one element rather than on the
        section's own pseudos. That began as a way to keep ::before free for
        the frame lines; the frame is gone, but the arrangement stays because
        this element's box is identical to the one the pseudos used, so the
        wash's percentages — and the measured contrast ceiling on them — hold
        without being re-derived. */}
    <div class="hero__fx" aria-hidden="true"></div>

    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="hero__h1">
          <span class="hero__l1">{h1Lead}</span>
          <span class="hero__l2"><span class="hero__mark">{mark}</span><b aria-hidden="true">.</b></span>
        </h1>

        <div class="hero__foot">
          <p class="lead measure">{t('home.lead')}</p>
          <div class="hero__actions">
            <a class="btn" href={route('contact', lang)}>{t('home.cta')}</a>
            {/* The callout belongs to this button, not to the row: when the
                buttons stack on a narrow phone, it has to stay under "See prices". */}
            <span class="hero__prices">
              <a class="btn btn--quiet" href={`${route('services', lang)}#pricing`}>{t('home.cta.secondary')}</a>
              <AsciiCallout text={t('home.callout')} align="end" />
            </span>
          </div>
        </div>
      </div>

      <div class="hero__pic" aria-hidden="true">
        <Illo name="desk" variant="sticker" class="hero__desk" />
        <Illo name="check" variant="sticker" class="hero__check" />
      </div>
    </div>

    <div class="hero__band" data-band>
      <div class="container hero__band-in">
        <p class="hero__band-label">{t('home.band.label')}</p>
        <div class="hero__band-run">
          <ul class="hero__band-track">
            {bandRun.map(({ item, copy }) => <li aria-hidden={copy > 0 ? 'true' : undefined}>{item}</li>)}
          </ul>
        </div>
        {/* WCAG 2.2.2: anything that moves on its own for more than five
            seconds next to other content needs a way to stop it. Shown by
            the script, so it never appears where it would do nothing. */}
        <button
          type="button"
          class="hero__band-pause"
          data-pause={t('home.band.pause')}
          data-play={t('home.band.play')}
          hidden
        >{t('home.band.pause')}</button>
      </div>
    </div>
  </section>

  {/* --- What we do -------------------------------------------------------
      Layout B from the illustration options, which David picked: copy-led
      lanes, one service to a row, instead of five cards. Each service keeps
      its own sticker at the end of the lane: at rest only the soft wash
      shows, and the sticker appears on it when the lane is pointed at or
      focused, so the section reads as type first and art second. With no
      hover (touch), the stickers simply sit there. */}
  <section class="services rails">
    <div class="container">
      <div class="services__head">
        <p class="label">{t('home.services.label')}</p>
        <h2>{t('home.services.h2')}</h2>
      </div>

      <ul class="lanes">
        {
          services.map((s) => (
            <li>
              <a class="lane" data-illo-zone href={`${route('services', lang)}#${s.key}`}>
                <span class="lane__n">{s.n}</span>
                <div class="lane__text">
                  <h3 class="lane__name">{s.name} <span class="lane__go" aria-hidden="true">&rarr;</span></h3>
                  <p class="lane__b">{s.b}</p>
                </div>
                <span class="lane__art">
                  <span class="icon-wash" aria-hidden="true">
                    <Illo name={s.key} variant="icon" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="lanes__more">
        <a href={route('services', lang)}>{t('home.services.link')} &rarr;</a>
      </p>
    </div>
  </section>

  {/* A breather between two light sections: a dotted ASCII row, where a
      diagonal hatch used to be. */}
  <AsciiDivider />

  {/* --- Position --------------------------------------------------------- */}
  <section class="position rails">
    <Illo name="fit" variant="aside" />

    <div class="container">
      <div class="position__head">
        <p class="label">{t('home.position.label')}</p>
        <h2 class="position__h2">{t('home.position.h2')}</h2>
        <p class="lead measure">{t('home.position.body')}</p>
      </div>

      <div class="position__grid">
        {
          position.map((p, i) => (
            <article class="point">
              <p class="point__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="point__h">{p.h}</h3>
              <p class="point__b">{p.b}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- Process ----------------------------------------------------------
      A timeline rather than a fourth grid of numbered cards. The site already
      has three of those (the service cards, the position points, About's
      "how"), and a process is a SEQUENCE — so it gets one continuous rule
      with a node where each step starts, instead of four separate boxes. */}
  <section class="process rails">
    <div class="container">
      <div class="process__head">
        <p class="label">{t('home.process.label')}</p>
        <h2>{t('home.process.h2')}</h2>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__h">{s.h}</h3>
              <p class="step__b">{s.b}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Closing lang={lang} />
</Base>

<script>
  /* The band's pause button. Hover pauses it too (CSS); this is for
     keyboard and touch. Nobody who asked for less motion sees the band move
     at all, so the button stays hidden for them. */
  const band = document.querySelector<HTMLElement>('[data-band]');
  const pause = band?.querySelector<HTMLButtonElement>('.hero__band-pause');
  if (band && pause && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    pause.hidden = false;
    pause.addEventListener('click', () => {
      const paused = band.toggleAttribute('data-paused');
      pause.textContent = (paused ? pause.dataset.play : pause.dataset.pause) ?? '';
    });
  }
</script>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    isolation: isolate;
    /* No bottom padding: the band closes the hero. */
    padding-block: var(--s6) 0;
    /* The wash is inset negatively so it bleeds past the section, and the
       drift pushes it further still — which put 244px of horizontal scroll
       on the page. `clip` on the x axis only, so the wash can still bleed
       UP behind the frosted header while never widening the document.
       (clip, not hidden: hidden would create a scroll container.) */
    overflow: clip;
  }

  @supports not (overflow: clip) {
    .hero {
      overflow: hidden;
    }
  }

  /* --- The wash ----------------------------------------------------------
     Two soft fields of colour behind the type, blue and purple, drifting
     slowly against each other. This is the site's second authored moment
     (the button sheen is the first) and it is confined to this one section.

     No blur filter: the radial stops are already soft, and a 60px blur on a
     box this size is a large, expensive layer for an effect the gradient
     gives for free.

     The 30% stops are a measured ceiling, not a look. The lead paragraph is
     --ink-muted, the weakest text in the hero, and it has to clear 4.5:1
     against the STRONGEST point of the wash — because the wash drifts and
     the layout reflows, so "the text probably isn't under the blob" is not
     something to rely on. At 30% the worst case is 5.1:1 (purple) and
     5.0:1 (blue). Purple at 42%, where this started, measured 4.34:1.

     --hx/--hy come from the pointer (see site.js) and are clamped to -1..1,
     so the centres can move at most 7% and the measured worst case above
     still bounds what any text can land on. */
  .hero__fx {
    position: absolute;
    z-index: -2;
    inset: 0;
    pointer-events: none;
  }

  .hero__fx::before {
    content: '';
    position: absolute;
    inset: -35% -12% -25%;
    background:
      radial-gradient(
        34% 38% at calc(78% + var(--hx, 0) * 7%) calc(24% + var(--hy, 0) * 6%),
        color-mix(in srgb, var(--purple) 26%, transparent),
        transparent 68%
      ),
      radial-gradient(
        40% 44% at calc(26% - var(--hx, 0) * 5%) calc(12% - var(--hy, 0) * 4%),
        color-mix(in srgb, var(--blue) 26%, transparent),
        transparent 70%
      );
    animation: hero-drift 26s var(--ease) infinite alternate;
    pointer-events: none;
  }

  /* Grain, over the wash and under the type. Without it the gradient reads as
     a flat CSS blob; with it, it reads as a surface. Very low opacity — it is
     texture, not a filter. */
  .hero__fx::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.16;
  }

  /* Transform only, so the drift runs on the compositor and never touches
     layout. prefers-reduced-motion is handled globally: the blanket rule
     collapses the duration, which parks the wash at its start position. */
  @keyframes hero-drift {
    from { transform: translate3d(-2%, -1%, 0) scale(1); }
    to { transform: translate3d(3%, 2%, 0) scale(1.09); }
  }

  /* Copy on the left, the picture on the right; one column below 60rem,
     the picture under the buttons. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s6) var(--s5);
    /* Tighter than a section, so the band still lands in the first screen
       of a 900px-tall laptop. */
    padding-block-end: var(--s6);
  }

  /* Smaller than --t-hero, which was sized for a headline with the whole
     width to itself. Two lines by construction: the lead-in, then the
     highlighted word. */
  .hero__h1 {
    font-size: clamp(2.5rem, 6.4vw, 6rem);
  }

  .hero__l1,
  .hero__l2 {
    display: block;
  }

  /* The highlighted word, webhero's device and David's reference. The block
     sits behind the type, starting a hair left of it so the word's first
     letter still lines up with the line above. --paper on --blue-fn is
     4.87:1, AA even at body size. */
  .hero__mark {
    position: relative;
    z-index: 0;
    display: inline-block;
    color: var(--paper);
    padding-inline: 0.08em;
    margin-inline-start: -0.08em;
  }

  .hero__mark::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.06em 0 -0.04em;
    background: var(--accent-fn);
    transform-origin: left center;
  }

  /* The accent lands on the full stop too, the same blue dot the wordmark
     ends on. Decorative and aria-hidden. */
  .hero__h1 b {
    color: var(--accent);
    font-weight: inherit;
  }

  .hero__foot {
    /* The query container for the "See prices" callout, below. */
    container-type: inline-size;
    display: grid;
    justify-items: start;
    gap: var(--s5);
    margin-block-start: var(--s5);
    /* Room for the callout, which hangs out of the flow under its button. */
    padding-block-end: var(--s4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s2);
  }

  /* The callout belongs to the "See prices" button.

     Stacked (a narrow phone): it wraps under the button, as wide as it, so
     the caret ends at the button's right edge. contain: inline-size keeps its
     text from widening the button.

     Side by side (the foot is at least 21rem wide, which both languages'
     buttons fit in side by side): it runs on one line, out of the flow,
     right-aligned to the button and extending left under the first one. */
  .hero__prices {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .hero__prices :global(.callout--end) {
    flex: none;
  }

  @container (min-width: 21rem) {
    .hero__prices :global(.callout--end) {
      position: absolute;
      inset-block-start: calc(100% + var(--s2));
      inset-inline-end: 0;
      contain: none;
      white-space: nowrap;
    }
  }

  /* --- The picture -----------------------------------------------------
     The desk (scripts/illo/scenes-hero.mjs) at its 1x width, 500px: one
     image pixel to one screen pixel keeps the dither crisp, and narrower
     columns scale it down. The check seal is a second sticker, 150px (30%),
     stamped over the laptop's top right corner. Both are Illo components,
     so their classes need :global() to be reached from here. */
  .hero__pic {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 500px);
  }

  .hero__pic :global(.hero__desk) {
    --illo-w: 100%;
  }

  .hero__pic :global(.hero__check) {
    position: absolute;
    inset-block-start: -8%;
    inset-inline-end: 2%;
    inline-size: 30%;
    --illo-w: 100%;
  }

  /* --- The landing -------------------------------------------------------
     Only for people who have not asked for less motion; everyone else, and
     anyone without CSS animation, gets the finished state, which is the
     state every element is written in. The picture lands, the seal is
     stamped on it, then the highlight fills. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__pic :global(.hero__desk) {
      animation: hero-slap 500ms var(--ease) 200ms both;
    }

    .hero__pic :global(.hero__check) {
      animation: hero-stamp 450ms cubic-bezier(0.3, 1.4, 0.5, 1) 900ms both;
    }

    .hero__mark::before {
      animation: hero-fill 450ms var(--ease) 1.35s both;
    }

    .hero__mark {
      animation: hero-ink 120ms ease-out 1.45s both;
    }
  }

  @keyframes hero-slap {
    from { opacity: 0; transform: translateY(-14px) scale(1.18); }
    70% { opacity: 1; transform: scale(0.98); }
    to { transform: none; }
  }

  @keyframes hero-stamp {
    from { opacity: 0; transform: scale(1.5) rotate(-25deg); }
    60% { opacity: 1; }
    to { transform: none; }
  }

  @keyframes hero-fill {
    from { transform: scaleX(0); }
  }

  @keyframes hero-ink {
    from { color: var(--fg); }
  }

  /* --- The band ----------------------------------------------------------
     The kinds of business we make sites for, moving slowly along the foot
     of the hero: the one continuous motion, in the place webhero runs its
     client logos. About 50px a second. Hover or the pause button stops it;
     with less motion asked for it never starts. */
  .hero__band {
    border-block-start: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tr-mono);
    color: var(--fg-muted);
  }

  .hero__band-in {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .hero__band-label {
    flex: none;
    margin: 0;
    padding-block: var(--s3);
    color: var(--fg);
  }

  .hero__band-label::before {
    content: '── ';
    color: var(--accent);
  }

  .hero__band-run {
    flex: 1 1 0;
    min-inline-size: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
  }

  .hero__band-track {
    display: flex;
    inline-size: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: hero-band 96s linear infinite;
  }

  .hero__band-track li {
    display: flex;
    gap: 2.5rem;
    padding-inline-end: 2.5rem;
    white-space: nowrap;
  }

  .hero__band-track li::after {
    content: '·';
    color: var(--accent-fn);
  }

  .hero__band:hover .hero__band-track,
  .hero__band[data-paused] .hero__band-track {
    animation-play-state: paused;
  }

  @keyframes hero-band {
    to { transform: translateX(-50%); }
  }

  .hero__band-pause {
    flex: none;
    padding: var(--s2) 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--fg);
    cursor: pointer;
  }

  .hero__band-pause::before { content: '['; color: var(--accent-fn); }
  .hero__band-pause::after { content: ']'; color: var(--accent-fn); }

  @media (prefers-reduced-motion: reduce) {
    .hero__band-track {
      animation: none;
    }
  }

  /* --- Narrower ----------------------------------------------------------
     One column: the picture goes under the buttons, a little smaller. */
  @media (max-width: 59.99rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__h1 {
      font-size: clamp(2.5rem, 10vw, 5.5rem);
    }

    .hero__pic {
      inline-size: min(100%, 26rem);
    }
  }

  /* On a phone the label and the button would leave the run one word wide,
     so the run takes a row of its own under them. */
  @media (max-width: 47.99rem) {
    .hero__band-in {
      flex-wrap: wrap;
      justify-content: space-between;
      row-gap: 0;
    }

    .hero__band-label {
      padding-block-end: 0;
    }

    .hero__band-run {
      order: 3;
      flex-basis: 100%;
      padding-block: var(--s2) var(--s3);
    }
  }

  /* --- Services ---------------------------------------------------------- */

  .services {
    padding-block: var(--section-y);
  }

  .services__head {
    display: grid;
    gap: var(--s3);
    margin-block-end: var(--s6);
  }

  /* --- What we do: lanes --------------------------------------------------
     Layout B from the illustration options, David's pick: copy-led lanes,
     one service to a row. The name is set at the Services page's own
     .svc__name size, so a service is one size wherever it is named, and the
     section is a second type moment rather than a grid of boxes. Rules
     BETWEEN lanes only, never around the set — a frame is the shape this
     system retired. */
  .lanes {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lanes > li + li {
    border-top: 1px solid var(--rule);
  }

  /* Four tracks: index, copy, art, arrow. Baseline-aligned, so the index and
     the arrow sit on the name's first line whatever the copy beneath it does;
     only the art centres on the lane. */
  .lane {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 15rem;
    grid-template-areas: 'n text art';
    align-items: baseline;
    column-gap: var(--s4);
    padding-block: var(--s4);
    color: var(--fg);
    text-decoration: none;
  }

  .lane__n {
    grid-area: n;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tr-mono);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .lane__text {
    grid-area: text;
    display: grid;
    gap: var(--s2);
    transition: transform var(--dur) var(--ease);
  }

  .lane__name {
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: var(--weight-heading);
    line-height: 1.04;
    transition: color var(--dur) var(--ease);
  }

  .lane__b {
    max-width: 52ch;
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  /* The sticker at its own 1x width, 224px, in the 15rem track: one image
     pixel to one screen pixel keeps the dither crisp. */
  .lane__art {
    grid-area: art;
    align-self: center;
    --illo-w: 224px;
  }

  /* Inline after the name now: the end of the lane belongs to the art,
     which is cut by the rail there. */
  .lane__go {
    display: inline-block;
    font-size: var(--t-h3);
    line-height: 1;
    /* --accent-fn, not --accent: a graphic carrying meaning at small size,
