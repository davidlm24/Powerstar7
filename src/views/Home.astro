  /* --- Services ---------------------------------------------------------- */

  /* The colour rhythm (David, 2026-10-19, option C, after his partner found
     the page empty next to the old Powerstar7 site, which changed ground 17
     times): paper, then the blue-wash band, then the dark process band, then
     the blue closing band. Each band carries --section-y top and bottom; the
     paper services section gets a bottom pad too, because a band follows it. */
  .services,
  .position,
  .work,
  .process {
    padding-block: var(--section-y);
  }

  .work__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s3);
    margin-block-end: var(--s5);
  }

  .work__all {
    font-size: var(--t-small);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s5) var(--s4);
  }

  @media (max-width: 59.99rem) {
    .work__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .position {
    background: var(--blue-wash);
  }

  .services__head {
    margin-block-end: var(--s5);
  }

  /* --- What we do: lanes --------------------------------------------------
     One service to a row, the whole container wide (David, 2026-10-20:
     "return to the vertical listing, but narrower" - vertically; the width
     stays). The row is as tall as the 224px print (172px) plus 1rem above
     and below, about 204px, where the first lanes were 285px. No rules
     between rows (2026-10-16 audit); the padding separates. */
  .lanes {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Two tracks: the copy and the art. */
  .lane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    grid-template-areas: 'text art';
    align-items: baseline;
    column-gap: var(--s4);
    padding-block: var(--s2);
    color: var(--fg);
    text-decoration: none;
  }

  .lane__text {
    grid-area: text;
    display: grid;
    gap: var(--s2);
    transition: transform var(--dur) var(--ease);
  }

  /* The Services page's own name size, so a service is one size wherever it
     is named. */
  .lane__name {
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: var(--weight-heading);
    line-height: 1.04;
    transition: color var(--dur) var(--ease);
  }

  .lane__b {
    max-width: var(--measure);
    font-size: var(--t-body);
    color: var(--fg-muted);
  }

  /* The print is the icon's own 224px render (the Services page's), one
     image pixel to one screen pixel, never a scaled dither. */
  .lane__art {
    grid-area: art;
    align-self: center;
    --illo-w: 224px;
  }

  /* Inline after the name. */
  .lane__go {
    display: inline-block;
    font-size: var(--t-h3);
    line-height: 1;
    /* --accent-fn, not --accent: a graphic carrying meaning at small size,
       and the display blue is 3.97:1. */
    color: var(--accent-fn);
    transition: transform var(--dur) var(--ease);
  }

  /* The copy steps in as the art relights — the whole column, name and body
     together, so the two never shear apart mid-move. */
  .lane:hover .lane__text,
  .lane:focus-visible .lane__text {
    transform: translateX(0.5rem);
  }

  .lane:hover .lane__name,
  .lane:focus-visible .lane__name {
    color: var(--accent-fn);
  }

  .lane:hover .lane__go,
  .lane:focus-visible .lane__go {
    transform: translateX(0.35rem);
  }

  .lanes__more {
    margin-block-start: var(--s4);
    font-size: var(--t-small);
  }

  /* On a phone there is no room for the print beside the copy: the row
     stacks and the art is dropped rather than squeezed. It is decorative;
     the row says everything without it. */
  @media (max-width: 40rem) {
    .lane {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'text';
      row-gap: var(--s2);
    }

    .lane__art {
      display: none;
    }
  }

  /* --- Process ----------------------------------------------------------- */

  .process__head {
    margin-block-end: var(--s5);
  }

  /* Four steps in a row, in an <ol>: the order is the content here, so these
     are the only numbers left on the page, in the text face and the
     functional blue. No rule or node any more (2026-10-16 audit). */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--s4);
  }

  .step__n {
    display: block;
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    color: var(--accent-fn);
    font-variant-numeric: tabular-nums;
    /* A process is an ORDER. The steps rise together, 70ms apart, which says
       "four things"; the numerals print in one after another, twice as far
       apart, after each step has landed, which says "in this order"
       (global.css, the print coming up). */
    --print-dur: 320ms;
    --print-delay: calc(var(--reveal-delay, 0ms) * 2 + 100ms);
  }

  .step__h {
    margin-block: var(--s2) var(--s1);
    font-size: var(--t-h3);
    line-height: 1.15;
  }

  .step__b {
    font-size: var(--t-body);
    color: var(--fg-muted);
  }

  /* The heading and lead, with the "fits your business" sticker beside them
     at its 1x width (244px). On a phone the sticker is hidden (global.css)
     and the column collapses. */
  .position__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 244px);
    align-items: center;
    gap: var(--s5);
  }

  .position__intro {
    display: grid;
    gap: var(--s3);
    max-width: 52rem;
  }

  @media (max-width: 59.99rem) {
    .position__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .position__h2 {
    max-width: 18ch;
  }

  /* column-gap 0 so each card's edge IS its divider; the air is padding inside
     the card instead. The lines cannot reach the h2 above because
     .position__grid is a SIBLING of .position__head, not its parent. */
  .position__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s5);
    margin-block-start: var(--s5);
  }

  /* Left-aligned, and the SAME padding on both sides of every cell.

     Centring made the old asymmetry impossible to miss: the first cell was
     centred inside 0 / 58px of padding so its text sat left of its own middle,
     and the last inside 58px / 0 so its text sat right of it. Only the middle
     cell was symmetric, and the three read as three different insets.

     The zeroed outer edges were deliberate once — they put the first cell
     flush with the heading above, on the grounds that clearance is bought
     from a divider and the outer edges have no divider to clear. That argument
     loses to the one the eye makes: three cells side by side have to match
     each other before any of them matches the heading.

     --s4, NOT --col-pad, and this is the only grid on the site that sets its
     own clearance rather than taking the system value. Equalising the padding
     makes the outer two cells pay 58px they never paid before, and at
     --col-pad that took the body measure down to 263px — short for running
     copy. --s4 hands ~56px back to every cell and keeps all three identical,
     which was the whole point of the change.

     The top rules still span the full cell, so the lines stay on the grid
     while the type steps in from it. */
  /* --col-pad buys clearance from a divider. The outer two edges have no
     divider to clear — the page-edge rail that used to sit there is gone — so
     the padding there was holding the band's text 3rem off nothing and making
     its measure 6rem narrower than the heading directly above it. */
  /* --accent-fn, not --accent. This band used to be inverted, where --accent
     resolves to --on-ink-blue at 6.40:1. On the light ground the display blue
     is 3.97:1, and 13px needs 4.5:1 — so the index would have failed the
     moment the band turned light. The functional sibling is 4.89:1. */
  .point__h {
    margin-block-end: var(--s2);
    font-size: var(--t-h3);
    line-height: 1.2;
  }

  .point__b {
    color: var(--fg-muted);
    font-size: var(--t-body);
  }

  /* --- Narrow ------------------------------------------------------------ */

  @media (max-width: 60rem) {
    /* Two abreast rather than four: at four, a step is about 60px wide on a
       phone and the names wrap to three lines each.

       The rule moves from the container to each step. One continuous line
       across the container only spans the FIRST row once the grid wraps, so
       the second row every node sat on nothing. A line per step is the same
       reading at two columns and it wraps with them. */
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--s5);
    }

    .position__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }
  }

  /* One step to a row on a phone. Two abreast suited the step NAMES, which
     were all this timeline carried at first; with a sentence under each, a
     130px column set it two or three words to a line and up to eleven lines
     deep. Below 30rem, which covers every portrait phone, each step gets the
     full width. */
  @media (max-width: 30rem) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

  }
