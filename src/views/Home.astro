---
import Base from '../layouts/Base.astro';
import Illo from '../components/Illo.astro';
import AsciiCallout from '../components/AsciiCallout.astro';
import Closing from '../components/Closing.astro';
import Accent from '../components/Accent.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../data/projects';
import { accentParts } from '../i18n/accent';
import { useTranslations, route, type Lang } from '../i18n/ui';
import { rampCss } from '../lib/bayer';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The rows carry svc.*.short: the first sentence of each service, which the
   Services page now opens its own, longer explanation with.

   Written out rather than built with a template literal, because
   t(`svc.${key}.body`) needs an `as any` cast and that quietly removes the
   type protection from every key it touches. */
const services = [
  { key: 'web', name: t('svc.web.name'), b: t('svc.web.short') },
  { key: 'brand', name: t('svc.brand.name'), b: t('svc.brand.short') },
  { key: 'seo', name: t('svc.seo.name'), b: t('svc.seo.short') },
  { key: 'email', name: t('svc.email.name'), b: t('svc.email.short') },
  { key: 'hosting', name: t('svc.hosting.name'), b: t('svc.hosting.short') },
] as const;

/* The headline's accent word (*word* in ui.ts) is also its highlighted word,
   and it has to be the last one: the headline is drawn as two lines, the
   lead-in and then the highlight. Anything else is a copy error, so the build
   stops on it rather than shipping a headline with nothing highlighted. */
const h1Parts = accentParts(t('home.h1'));
const [h1Lead, h1Mark, h1End] = h1Parts;
if (
  h1Parts.length > 3 ||
  !h1Lead || h1Lead.accent ||
  !h1Mark?.accent ||
  (h1End && h1End.text.trim() !== '.')
) {
  throw new Error(`home.h1 must be "lead-in *word*." with the accent last (${lang})`);
}

/* The band along the foot of the hero. The first copy is the one screen
   readers get; the other three only keep the loop seamless, because half
   the track has to be wider than the widest screen for translateX(-50%) to
   come back round without a gap. */
const band = t('home.band.items').split(',').map((s) => s.trim());
const bandRun = [0, 1, 2, 3].flatMap((copy) => band.map((item) => ({ item, copy })));

/* Each step restates a commitment the site already makes elsewhere: a
   written scope with the price attached (About), design reviewed on real
   devices (Services), code with no builder underneath and WCAG AA as the
   floor (Services), and a handover in the client's name with a written guide
   (the position section). So nothing here claims anything new. The
   descriptions are drafts, written 2026-09-24; rewrite them freely. */
const steps = [
  { h: t('home.process.s1.h'), b: t('home.process.s1.b') },
  { h: t('home.process.s2.h'), b: t('home.process.s2.b') },
  { h: t('home.process.s3.h'), b: t('home.process.s3.b') },
  { h: t('home.process.s4.h'), b: t('home.process.s4.b') },
];

const position = [
  { h: t('home.position.one.h'), b: t('home.position.one.b') },
  { h: t('home.position.two.h'), b: t('home.position.two.b') },
  { h: t('home.position.three.h'), b: t('home.position.three.b') },
];
---

<Base lang={lang} page="home" title={t('home.title')} dither>
  {/* The Bayer ramp the highlight wipes in behind (src/lib/bayer.ts). A
      data URI in a custom property: not a request. Astro's scoped style
      cannot take a frontmatter value, hence set:html. */}
  <Fragment set:html={`<style>:root{${rampCss()}}</style>`} />
  {/* --- Hero ------------------------------------------------------------
      David's picks (2026-10-14): "Your website, sorted." with the last word
      highlighted, and a slow band of the kinds of business we make sites for
      along the foot. The picture beside it (David, 2026-10-20) is the same
      laptop, phone and plant, now a live print: the browser on the laptop
      is resized by the pointer, or by an idle cursor, and its page reflows
      into the phone's below 768px (hero-print.js). */}
  <section class="hero rails">
    {/* Both decorative layers live on this one element rather than on the
        section's own pseudos. That began as a way to keep ::before free for
        the frame lines; the frame is gone, but the arrangement stays because
        this element's box is identical to the one the pseudos used, so the
        wash's percentages — and the measured contrast ceiling on them — hold
        without being re-derived. */}
    <div class="hero__fx" aria-hidden="true"></div>
    {/* The wash as dots: 1px Bayer dither drifting slowly, drawn in WebGL
        by dither-site.js and kept clear of every line of text. Shown only
        once it draws (.has-dots); the CSS wash above is what everyone
        else sees. */}
    <canvas class="hero__dots" aria-hidden="true"></canvas>

    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="hero__h1">
          <span class="hero__l1">{h1Lead.text.trimEnd()}</span>
          <span class="hero__l2"><span class="hero__mark accent">{h1Mark.text}</span><b aria-hidden="true">.</b></span>
        </h1>

        <div class="hero__foot">
          <p class="lead measure">{t('home.lead')}</p>
          <div class="hero__actions">
            <a class="btn" href={route('contact', lang)}>{t('home.cta')}</a>
            {/* The callout belongs to this button, not to the row: when the
                buttons stack on a narrow phone, it has to stay under "See prices". */}
            <span class="hero__prices">
              <a class="btn btn--quiet" href={route('pricing', lang)}>{t('home.cta.secondary')}</a>
              <AsciiCallout text={t('home.callout')} align="end" />
            </span>
          </div>
        </div>
      </div>

      {/* The still is the same print at rest, for the first paint and for no
          JS; the canvas replaces it once it has printed (.is-live). The stage
          holds the hidden line figure and takes the pointer. */}
      <div class="hero__pic" aria-hidden="true" data-wash-clear data-hero-print>
        {/* One file for every screen: a dot is one CSS pixel at any density,
            and pixelated scaling keeps it crisp at 2x. */}
        <img class="hero__still" src="/assets/illo/hero-responsive.png" width="635" height="508" alt="" fetchpriority="high" />
        <div class="hero__stage"></div>
        <canvas class="hero__canvas"></canvas>
        <span class="hero__read"></span>
      </div>
    </div>

    <div class="hero__band invert" data-band>
      <div class="container hero__band-in">
        <p class="hero__band-label">{t('home.band.label')}</p>
        <div class="hero__band-run">
          <ul class="hero__band-track">
            {bandRun.map(({ item, copy }) => <li aria-hidden={copy > 0 ? 'true' : undefined}>{item}</li>)}
          </ul>
        </div>
        {/* WCAG 2.2.2: anything that moves on its own for more than five
            seconds next to other content needs a way to stop it. The visible
            [pause] went (David, 2026-10-20); the mechanism stays: hover
            pauses it, tapping or clicking the stripe toggles it, and this
            button is the keyboard and screen-reader route, drawn only while
            it has focus. Shown by the script, so it never appears where it
            would do nothing. */}
        <button
          type="button"
          class="hero__band-pause"
          data-pause={t('home.band.pause')}
          data-play={t('home.band.play')}
          hidden
        >{t('home.band.pause')}</button>
      </div>
    </div>
  </section>

  {/* --- What we do -------------------------------------------------------
      Back to one service to a row (David, 2026-10-20), full width, and
      SHORT: "narrower" meant vertically. A row is as tall as its print and a
      little padding, not the copy plus a big picture. Each row goes to its
      own explanation on the Services page. The print rests at full strength
      on its soft wash and is relit by the pointer, like the hero's. */}
  <section class="services rails">
    <div class="container">
      <div class="services__head">
        <h2><Accent text={t('home.services.h2')} /></h2>
      </div>

      <ul class="lanes">
        {
          services.map((s) => (
            <li>
              <a class="lane" data-illo-zone href={`${route('services', lang)}#${s.key}`}>
                <div class="lane__text">
                  <h3 class="lane__name">{s.name} <span class="lane__go" aria-hidden="true">&rarr;</span></h3>
                  <p class="lane__b">{s.b}</p>
                </div>
                <div class="lane__art">
                  <div class="icon-wash" aria-hidden="true">
                    <Illo name={s.key} variant="icon" />
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="lanes__more">
        <a href={route('services', lang)}>{t('home.services.link')} &rarr;</a>
      </p>
    </div>
  </section>

  {/* --- Position --------------------------------------------------------- */}
  <section class="position rails">
    <div class="container">
      <div class="position__head">
        <div class="position__intro">
          <h2 class="position__h2"><Accent text={t('home.position.h2')} /></h2>
          <p class="lead measure">{t('home.position.body')}</p>
        </div>
        <Illo name="fit" variant="aside" />
      </div>

      <div class="position__grid">
        {
          position.map((p, i) => (
            <article class="point">
              <h3 class="point__h">{p.h}</h3>
              <p class="point__b">{p.b}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- Recent work -----------------------------------------------------
      The three client sites the team built (as Powerstar7), back on the home
      page as the old site had them (David, 2026-10-19). On paper, between the
      blue-wash band and the dark process band. */}
  <section class="work rails">
    <div class="container">
      <div class="work__head">
        <h2><Accent text={t('home.work.h2')} /></h2>
        <a class="work__all" href={route('work', lang)}>{t('home.work.link')} &rarr;</a>
      </div>
      <div class="work__grid">
        {PROJECTS.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </div>
  </section>

  {/* --- Process ----------------------------------------------------------
      A timeline rather than a fourth grid of numbered cards. The site already
      has three of those (the service cards, the position points, About's
      "how"), and a process is a SEQUENCE — so it gets one continuous rule
      with a node where each step starts, instead of four separate boxes. */}
  <section class="process rails invert">
    <div class="container">
      <div class="process__head">
        <h2><Accent text={t('home.process.h2')} /></h2>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__n print-in">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__h">{s.h}</h3>
              <p class="step__b">{s.b}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Closing lang={lang} />
  {/* The hero print: the kernel and the print first, then the figure, which
      mounts itself. Deferred classic scripts and module scripts run in
      document order, after the parse. */}
  <script src="/assets/js/hairline/kernel.js" defer is:inline></script>
  <script src="/assets/js/hero-print.js" defer is:inline></script>
  <script type="module" src="/assets/js/hairline/responsive.js" is:inline></script>
</Base>

<script>
  /* The band's pause. Hover pauses it too (CSS); this is for keyboard and
     touch: the button (shown only on focus) and a tap on the stripe itself.
     Nobody who asked for less motion sees the band move at all, so the
     button stays hidden for them. */
  const band = document.querySelector<HTMLElement>('[data-band]');
  const pause = band?.querySelector<HTMLButtonElement>('.hero__band-pause');
  if (band && pause && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    pause.hidden = false;
    const toggle = () => {
      const paused = band.toggleAttribute('data-paused');
      pause.textContent = (paused ? pause.dataset.play : pause.dataset.pause) ?? '';
      pause.setAttribute('aria-pressed', String(paused));
    };
    pause.addEventListener('click', toggle);
    band.addEventListener('click', (e) => {
      if (e.target !== pause) toggle();
    });
  }
</script>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    isolation: isolate;
    /* Pulled up under the transparent header, so the wash runs behind it.
       The bottom padding is room for the band's lean: the stripe tilts 1.3
       degrees about its middle, so its lower corner drops about 1.3vw below
       where it would sit level. overflow: clip cuts at the padding box, so
       the drop has to be inside it (a margin on the band collapsed out of
       the hero and the corner was clipped flat, 2026-10-20). */
    margin-block-start: calc(-1 * var(--header-h));
    padding-block: calc(var(--s6) + var(--header-h)) calc(var(--s2) + 1.3vw);
    /* The wash is inset negatively so it bleeds past the section, and the
       drift pushes it further still — which put 244px of horizontal scroll
       on the page. `clip` on the x axis only, so the wash can still bleed
       UP behind the frosted header while never widening the document.
       (clip, not hidden: hidden would create a scroll container.) */
    overflow: clip;
  }

  @supports not (overflow: clip) {
    .hero {
      overflow: hidden;
    }
  }

  /* --- The wash ----------------------------------------------------------
     Two soft fields of colour behind the type, blue and purple, drifting
     slowly against each other. This is the site's second authored moment
     (the button sheen is the first) and it is confined to this one section.

     No blur filter: the radial stops are already soft, and a 60px blur on a
     box this size is a large, expensive layer for an effect the gradient
     gives for free.

     The 30% stops are a measured ceiling, not a look. The lead paragraph is
     --ink-muted, the weakest text in the hero, and it has to clear 4.5:1
     against the STRONGEST point of the wash — because the wash drifts and
     the layout reflows, so "the text probably isn't under the blob" is not
     something to rely on. At 30% the worst case is 5.1:1 (purple) and
     5.0:1 (blue). Purple at 42%, where this started, measured 4.34:1.

     --hx/--hy come from the pointer (see site.js) and are clamped to -1..1,
     so the centres can move at most 7% and the measured worst case above
     still bounds what any text can land on. */
  .hero__fx {
    position: absolute;
    z-index: -2;
    inset: 0;
    pointer-events: none;
  }

  .hero__fx::before {
    content: '';
    position: absolute;
    inset: -35% -12% -25%;
    background:
      radial-gradient(
        34% 38% at calc(70% + var(--hx, 0) * 7%) calc(14% + var(--hy, 0) * 6%),
        color-mix(in srgb, var(--purple) 26%, transparent),
        transparent 68%
      ),
      radial-gradient(
        40% 44% at calc(90% - var(--hx, 0) * 5%) calc(52% - var(--hy, 0) * 4%),
        color-mix(in srgb, var(--blue) 26%, transparent),
        transparent 70%
      );
    /* Rising from the right and dissipating before it reaches the copy
       (David, 2026-10-19); the WebGL dots fade the same way (dither.js),
       and both stay cleared off the text itself. */
    -webkit-mask-image: linear-gradient(100deg, transparent 30%, #000 58%);
    mask-image: linear-gradient(100deg, transparent 30%, #000 58%);
    animation: hero-drift 26s var(--ease) infinite alternate;
    pointer-events: none;
  }

  /* Grain, over the wash and under the type. Without it the gradient reads as
     a flat CSS blob; with it, it reads as a surface. Very low opacity — it is
     texture, not a filter. */
  .hero__fx::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.16;
  }

  /* The dots. Under the rails like the CSS wash; inset 0, so nothing of
     it ever leaves the hero's clipped box. */
  .hero__dots {
    position: absolute;
    z-index: -2;
    inset: 0;
    display: none;
    pointer-events: none;
  }

  .hero.has-dots .hero__dots { display: block; }
  .hero.has-dots .hero__fx { display: none; }

  /* The wash ends behind the stripe, on the line through its middle, so no
     dots show in the strip of padding under it and nothing ends in a
     straight edge. The padding is s2 + 1.3vw; 2.1rem is about half the
     stripe's own height. Negative insets leave the other three sides
     unclipped, so the fx layer still bleeds up behind the header. */
  .hero__fx,
  .hero__dots {
    clip-path: inset(-100vh -100vw calc(var(--s2) + 1.3vw + 2.1rem) -100vw);
  }

  /* Transform only, so the drift runs on the compositor and never touches
     layout. prefers-reduced-motion is handled globally: the blanket rule
     collapses the duration, which parks the wash at its start position. */
  @keyframes hero-drift {
    from { transform: translate3d(-2%, -1%, 0) scale(1); }
    to { transform: translate3d(3%, 2%, 0) scale(1.09); }
  }

  /* Copy on the left, the picture on the right; one column below 60rem,
     the picture under the buttons. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s6) var(--s5);
    /* Tighter than a section, so the band still lands in the first screen
       of a 900px-tall laptop. */
    padding-block-end: var(--s6);
  }

  /* Smaller than --t-hero, which was sized for a headline with the whole
     width to itself. Two lines by construction: the lead-in, then the
     highlighted word. */
  .hero__h1 {
    font-size: clamp(2.5rem, 6.4vw, 6rem);
  }

  .hero__l1,
  .hero__l2 {
    display: block;
  }

  /* The highlighted word, webhero's device and David's reference, set in the
     serif italic like every accent word. The block sits behind the type,
     starting a hair left of it so the word's first letter still lines up with
     the line above, and a little wider on the right for the italic's
     overhang. --paper on --blue-fn is 4.87:1, AA even at body size. */
  .hero__mark {
    position: relative;
    z-index: 0;
    display: inline-block;
    color: var(--paper);
    padding-inline: 0.08em 0.1em;
    margin-inline-start: -0.08em;
  }

  .hero__mark::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.08em 0 -0.02em;
    background: var(--accent-fn);
    transform-origin: left center;
  }

  /* The accent lands on the full stop too, the same blue dot the wordmark
     ends on. Decorative and aria-hidden. */
  .hero__h1 b {
    color: var(--accent);
    font-weight: inherit;
  }

  .hero__foot {
    /* The query container for the "See prices" callout, below. */
    container-type: inline-size;
    display: grid;
    justify-items: start;
    gap: var(--s5);
    margin-block-start: var(--s5);
    /* Room for the callout, which hangs out of the flow under its button. */
    padding-block-end: var(--s4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s2);
  }

  /* The callout belongs to the "See prices" button.

     Stacked (a narrow phone): it wraps under the button, as wide as it, so
     the caret ends at the button's right edge. contain: inline-size keeps its
     text from widening the button.

     Side by side (the foot is at least 21rem wide, which both languages'
     buttons fit in side by side): it runs on one line, out of the flow,
     right-aligned to the button and extending left under the first one. */
  .hero__prices {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .hero__prices :global(.callout--end) {
    flex: none;
  }

  @container (min-width: 21rem) {
    .hero__prices :global(.callout--end) {
      position: absolute;
      inset-block-start: calc(100% + var(--s2));
      inset-inline-end: 0;
      contain: none;
      white-space: nowrap;
    }
  }

  /* --- The picture -----------------------------------------------------
     The live print (hero-print.js). The drawing fills about three quarters
     of the figure's 5:4 frame, so the frame runs past its column by a
     little (into the gap) to give the laptop the old desk's presence.
     The still and the canvas are the same print; the canvas sizes itself
     to whole device pixels from the stage, which holds the hidden line
     figure and takes the pointer. */
  .hero__pic {
    position: relative;
    justify-self: center;
    inline-size: min(100% + var(--s5), 640px);
    margin-inline-start: calc(-1 * var(--s5));
  }

  .hero__still {
    display: block;
    inline-size: 100%;
    block-size: auto;
    image-rendering: pixelated;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
  }

  .hero__stage :global(svg) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    opacity: 0;
  }

  .hero__canvas {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    pointer-events: none;
    image-rendering: pixelated;
  }

  .hero__pic.is-live .hero__still { visibility: hidden; }

  /* The width the pointer has set, while it is set: the figure's read-out,
     just above the laptop lid's top right corner (the camera never moves). */
  .hero__read {
    position: absolute;
    inset-block-start: 9%;
    inset-inline-start: 66%;
    font: 500 var(--t-micro) / 1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    pointer-events: none;
  }

  /* --- The landing -------------------------------------------------------
     Only for people who have not asked for less motion; everyone else, and
     anyone without CSS animation, gets the finished state, which is the
     state every element is written in. The highlight fills; the picture
     moves on its own (hero-print.js). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__mark::before {
      animation: hero-fill 450ms var(--ease) 1.35s both;
    }

    .hero__mark {
      animation: hero-ink 120ms ease-out 1.45s both;
    }
  }

  @keyframes hero-fill {
    from { transform: scaleX(0); }
  }

  @keyframes hero-ink {
    from { color: var(--fg); }
  }

  /* --- The landing, in dots (html.dither: dither-site.js is running) ------
     The highlight wipes in behind a dithered edge (the Bayer ramp mask)
     instead of scaling, keyed on .is-run, which the script adds once it is
     ready. If html.dither is withdrawn (the 2.5s fallback) the rules above
     take over with their delays long gone: everything sits in its finished
     state. */
  html.dither .hero__mark,
  html.dither .hero__mark::before { animation: none; }

  html.dither .hero__mark { color: var(--fg); }
  html.dither .hero__mark::before {
    visibility: hidden;
    mask-image: var(--dz-ramp);
    mask-repeat: repeat-y;
    mask-size: calc(var(--dz-ramp-w) * 1px) 4px;
    mask-position: right calc(var(--dz-ramp-off) * -1px) top 0;
  }

  html.dither .hero.is-run .hero__mark { animation: hero-ink 1ms linear 1.6s both; }
  html.dither .hero.is-run .hero__mark::before {
    visibility: visible;
    animation: hero-wipe 560ms linear 1.35s both;
  }

  @keyframes hero-wipe {
    from { mask-position: left calc(var(--dz-ramp-off) * -1px) top 0; }
  }

  /* --- The band ----------------------------------------------------------
     The kinds of business we make sites for, moving slowly along a black
     stripe set a little off the horizontal (David, 2026-10-20): the one
     continuous motion, in the place webhero runs its client logos. About
     50px a second. The stripe is .invert, so every role flips by itself
     (on-ink 15.6:1 on the stripe). The black is a ::before layer 6% wider
     than the page each side, so it runs past both edges, while the band
     itself is the page's own width: the label and the run sit on the same
     content edge as the headline at every width, where a 112% band put the
     label off-screen below about 1300px. It leans 1.3 degrees; the hero's
     bottom padding holds the lowered corner. Hover pauses it, tapping it
     toggles it; with less motion asked for it never starts. */
  .hero__band {
    position: relative;
    z-index: 1;
    margin-block: var(--s2) 0;
    background: none;
    transform: rotate(-1.3deg);
    font-family: var(--font-mono);
