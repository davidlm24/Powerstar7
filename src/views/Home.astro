---
/* The home page (the 2026-11 redesign; trial rounds 1-7 on /lab/home-dark,
   rolled out 2026-11-26). Dark by default with a light theme (Base).

   ONE grid: every section sits on the same four columns between the rails
   (Sheet + src/styles/grid.css). Cells draw their own top and right edges,
   so nothing is drawn twice; only the rails run through the gaps between
   sections. Section titles live inside the grid, in cells of their own.
   Illustrations are pixel art (Glyph.astro); the hero is a live pixel field
   (HeroPixels) with example sites on its right (HeroStage). The copy is
   the short set (home.h1, home.lead, home.svc.*, home.fit.*, home.step.* in
   ui.ts).

   Impeccable pass, 2026-11-27: the page shows why to choose the studio
   before it explains anything. The hero stage shows real client sites; a
   row of four facts under it (from-price, price in writing, 2-4 weeks,
   optional care) replaced the services strip; the fourth "fits" cell holds
   this page's measured figures; and a line draws through the four process
   steps as they scroll by. The hero shows example sites, not client
   projects: David took the Powerstar7-era projects off the site, so
   "Recent work" is gone too. */
import Base from '../layouts/Base.astro';
import Accent from '../components/Accent.astro';
import Glyph, { type GlyphName } from '../components/Glyph.astro';
import HeroPixels from '../components/HeroPixels.astro';
import HeroStage from '../components/HeroStage.astro';
import Sheet from '../components/Sheet.astro';
import Pluses from '../components/Pluses.astro';
import ClosingPanel from '../components/ClosingPanel.astro';
import { PRICING, euros } from '../data/pricing';
import { useTranslations, route, metrics, type Lang } from '../i18n/ui';
import { accentParts } from '../i18n/accent';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services: { key: GlyphName; name: string; b: string }[] = [
  { key: 'web', name: t('svc.web.name'), b: t('home.svc.web') },
  { key: 'brand', name: t('svc.brand.name'), b: t('home.svc.brand') },
  { key: 'seo', name: t('svc.seo.name'), b: t('home.svc.seo') },
  { key: 'email', name: t('svc.email.name'), b: t('home.svc.email') },
  { key: 'hosting', name: t('svc.hosting.name'), b: t('home.svc.hosting') },
];

const position: { g: GlyphName; h: string; b: string }[] = [
  { g: 'use', h: t('home.position.one.h'), b: t('home.fit.one') },
  { g: 'seo', h: t('home.position.two.h'), b: t('home.fit.two') },
  { g: 'own', h: t('home.position.three.h'), b: t('home.fit.three') },
];

const steps = [
  { h: t('home.process.s1.h'), b: t('home.step.one') },
  { h: t('home.process.s2.h'), b: t('home.step.two') },
  { h: t('home.process.s3.h'), b: t('home.step.three') },
  { h: t('home.process.s4.h'), b: t('home.step.four') },
];

const h1 = accentParts(t('home.h1'));

/* The four reasons, in the order a visitor asks them: how much, how sure,
   how long, and what after. Prices come from pricing.ts, never typed. */
const facts = [
  { v: t('home.fact.price.v', { price: euros(PRICING.design, lang) }), b: t('home.fact.price.b'), href: route('pricing', lang) },
  { v: t('home.fact.proposal.v'), b: t('home.fact.proposal.b') },
  { v: t('home.fact.time.v'), b: t('home.fact.time.b') },
  { v: t('home.fact.care.v', { price: euros(PRICING.care, lang) }), b: t('home.fact.care.b') },
];

/* This page's own measured figures (scripts/measure.mjs), shown in the
   fourth "fits" cell; the Work page has the full set. */
const measuredOn = metrics.measuredAt
  ? new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(metrics.measuredAt))
  : '';
const hasFigures = metrics.measuredAt !== null && metrics.weightKb > 0;

/* The "+" marks sit only where a line really crosses: the rails always, and
   an inner column line only where a cell edge meets that section's top or
   bottom line (the gaps between sections carry the rails only, round 6). */
const PLUS = [0, 25, 50, 75, 100];
const RAILS = [0, 100];
const TOP_SERVICES = [0, 50, 75, 100];
const TOP_POSITION = [0, 50, 100];
---

<Base lang={lang} page="home" title={t('home.title')}>
  <Sheet>

    {/* --- Hero ------------------------------------------------------------ */}
    <section class="frame frame--hero">
      <div class="hero on-blue" data-float>
        <div class="hero__light" aria-hidden="true"></div>
        <HeroPixels />
        <div class="hero__copy">
          <h1 class="hero__h1">
            {h1.map((p) => (p.accent ? <span class="hero__mark">{p.text}</span> : p.text))}
          </h1>
          <p class="hero__lead">{t('home.lead')}</p>
          <div class="hero__actions">
            <a class="btn" href={route('contact', lang)}>{t('home.cta')}</a>
            <a class="btn btn--quiet" href={route('pricing', lang)}>{t('home.cta.secondary')}</a>
          </div>
        </div>
        {/* Where the drawings go. The motion is paused from the footer's
            Animation switch (WCAG 2.2.2), not from a button here. */}
        <div class="hero__px">
          <HeroStage lang={lang} />
        </div>
      </div>

      {/* The reasons, as a row of the grid right under the hero. Each value
          prints in dots once as the page opens (.print-now, only with
          motion allowed), 90ms apart. */}
      <div class="facts-wrap">
        <Pluses at={PLUS} narrow={[0, 50, 100]} />
        <ul class="grid facts">
          {facts.map((f, i) => (
            <li class:list={['cell', 'fact', f.href && 'cell--link']} style={`--i: ${i}`}>
              {f.href ? (
                <a class="fact__link" href={f.href}>
                  <span class="fact__v print-now">{f.v} <span class="cell__go" aria-hidden="true">&rarr;</span></span>
                  <span class="fact__b">{f.b}</span>
                </a>
              ) : (
                <>
                  <span class="fact__v print-now">{f.v}</span>
                  <span class="fact__b">{f.b}</span>
                </>
              )}
            </li>
          ))}
        </ul>
        <Pluses at={PLUS} narrow={[0, 50, 100]} end />
      </div>
    </section>

    {/* --- Services -------------------------------------------------------- */}
    <section class="frame">
      <Pluses at={TOP_SERVICES} />
      <div class="grid">
        <div class="cell cell--head span-2">
          <h2 class="head__h"><Accent text={t('home.services.h2')} /></h2>
        </div>
        {services.map((s) => (
          <a class="cell cell--link" href={`${route('services', lang)}#${s.key}`} data-glyph-zone>
            <span class="cell__art"><Glyph name={s.key} size={96} /></span>
            <h3 class="cell__h">{s.name} <span class="cell__go" aria-hidden="true">&rarr;</span></h3>
            <p class="cell__b">{s.b}</p>
          </a>
        ))}
        <a class="cell cell--link cell--more" href={route('services', lang)} data-glyph-zone>
          <span class="cell__art"><Glyph name="more" size={96} /></span>
          <h3 class="cell__h cell__h--big">{t('home.services.link')} <span class="cell__go" aria-hidden="true">&rarr;</span></h3>
        </a>
      </div>
      <Pluses at={PLUS} narrow={[0, 50, 100]} end />
    </section>

    {/* --- Position --------------------------------------------------------- */}
    <section class="frame">
      <Pluses at={TOP_POSITION} />
      <div class="grid">
        <div class="cell cell--head span-2">
          <h2 class="head__h"><Accent text={t('home.position.h2')} /></h2>
        </div>
        <div class="cell cell--lead span-2">
          <p class="head__lead">{t('home.fit.lead')}</p>
        </div>
        {position.map((p) => (
          <article class="cell" data-glyph-zone>
            <span class="cell__art"><Glyph name={p.g} size={48} /></span>
            <h3 class="cell__h">{p.h}</h3>
            <p class="cell__b">{p.b}</p>
          </article>
        ))}
        {hasFigures && (
          <a class="cell cell--link proof" href={`${route('work', lang)}#this`}>
            <dl class="proof__list">
              <div class="proof__fig">
                <dt>{t('home.proof.weight')}</dt>
                <dd>{Math.round(metrics.weightKb)}<span>KB</span></dd>
              </div>
              <div class="proof__fig">
                <dt>{t('home.proof.cookies')}</dt>
                <dd>{metrics.cookies}</dd>
              </div>
              <div class="proof__fig">
                <dt>{t('home.proof.thirdParty')}</dt>
                <dd>{metrics.thirdPartyRequests}</dd>
              </div>
            </dl>
            <span class="proof__note">{t('home.proof.note', { date: measuredOn })} <span class="cell__go" aria-hidden="true">&rarr;</span></span>
          </a>
        )}
      </div>
      <Pluses at={PLUS} narrow={[0, 50, 100]} end />
    </section>

    {/* --- Process: the one place numbers belong (it is a sequence) -------- */}
    <section class="frame">
      <Pluses at={RAILS} />
      <div class="grid">
        <div class="cell cell--head span-4">
          <h2 class="head__h"><Accent text={t('home.process.h2')} /></h2>
        </div>
        <ol class="row steps">
          {steps.map((s, i) => (
            <li class="cell" style={`--k: ${i}`}>
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="cell__h">{s.h}</h3>
              <p class="cell__b">{s.b}</p>
            </li>
          ))}
        </ol>
      </div>
      <Pluses at={PLUS} narrow={[0, 50, 100]} end />
    </section>

    <ClosingPanel lang={lang} lead={t('closing.short')} />
  </Sheet>

  <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // The header's "Start a project" steps back while the hero's own is
      // on screen, so the first screen asks once; it returns as the hero
      // leaves. Without this script (or the observer) it simply stays.
      var heroCta = document.querySelector('.hero__actions');
      if (heroCta && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          document.documentElement.classList.toggle('hero-cta-in', es[es.length - 1].isIntersecting);
        }).observe(heroCta);
      }

      if (reduce || !('IntersectionObserver' in window)) return;

      // Each glyph's pixels light up once, when its cell first comes into view.
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-play');
          io.unobserve(e.target);
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('[data-glyph-zone]').forEach(function (el) {
        io.observe(el);
        // Replay on hover or focus; the class stays until the wave has run
        // (560ms + 22 diagonals x 22ms), so leaving early never cuts it off.
        var t = 0;
        var again = function (e) {
          if (e.type === 'pointerenter' && e.pointerType !== 'mouse') return;
          if (el.classList.contains('is-again')) return;
          el.classList.add('is-again');
          clearTimeout(t);
          t = setTimeout(function () { el.classList.remove('is-again'); }, 1100);
        };
        el.addEventListener('pointerenter', again);
        el.addEventListener('focusin', again);
      });

      // The two blue panels drift a few pixels against the scroll.
      var floats = document.querySelectorAll('[data-float]');
      var ticking = false;
      var drift = function () {
        ticking = false;
        var h = innerHeight;
        floats.forEach(function (el) {
          var r = el.getBoundingClientRect();
          var d = ((r.top + r.height / 2) - h / 2) / h;
          el.style.setProperty('--drift', Math.max(-1, Math.min(1, d)) * -5 + 'px');
        });
      };
      addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(drift); } }, { passive: true });
      drift();
    })();
  </script>
</Base>

<style>
  /* The shared grid lives in src/styles/grid.css (Sheet.astro); what is
     here is the home page's own. */

  .cell--more { align-content: end; }

  .step__n {
    display: inline-grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    margin-block-end: 0.75rem;
    border: 1px solid var(--accent-fn);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--accent-fn);
  }

  /* --- Hero ------------------------------------------------------------------ */
  .frame--hero { padding-block: var(--s2) 0; }

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    min-block-size: clamp(30rem, 44vw, 38rem);
    border-radius: var(--radius-float);
    overflow: clip;
    transform: translateY(var(--drift, 0px));
  }

  /* Blue to almost clear: solid behind the copy (columns 1-2), fading out
     across columns 3-4 so the page and its grid lines show through behind
     the pixels. White on the blue is 6.1:1 at the left edge and 5.5:1 at
     45 %, where the lead ends. */
  .hero__light {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Blue to a light blue, opaque (David, round 5). White on it: 6.1:1 at
       the left edge, 5.5:1 at 45 % and about 5.1:1 at 50 %, where the lead
       ends; the light end (#5a9bff) is behind the pixels only. */
    background:
      radial-gradient(45% 70% at 8% 0%, rgb(255 255 255 / 0.12), transparent 70%),
      linear-gradient(90deg, #0b5bd3 0%, var(--blue-fn) 45%, #5a9bff 100%);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    grid-column: 1 / span 2;
    align-self: center;
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.75rem, 5vw, 5rem);
  }

  .hero__h1 {
    font-size: clamp(2.75rem, 6.4vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 500;
    color: #fff;
    text-wrap: balance;
  }

  .hero__mark { color: #cfe0ff; }

  /* The hero is above the fold: it never waits for the scroll entrance. */
  :global(.reveal) .hero__h1 {
    opacity: 1 !important;
    transform: none !important;
  }

  .hero__lead {
    margin-block-start: 1.5rem;
    max-inline-size: 30ch;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.45;
    color: var(--fg-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  /* The stage: where the drawings sit. The field itself (HeroPixels)
     covers the whole hero, under the copy. */
  .hero__px {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    grid-column: 3 / span 2;
    align-self: center;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.75rem, 4vw, 4rem);
    min-inline-size: 0;
  }

  /* White pixels on the blue, in both themes. */
  .hero { --px-ink: #ffffff; }

  @media (max-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 1fr); min-block-size: 0; }
    .hero__copy, .hero__px { grid-column: 1; }
    .hero__px { padding-block-start: 0; max-inline-size: 34rem; }
    .hero__light {
      background:
        radial-gradient(70% 40% at 8% 0%, rgb(255 255 255 / 0.1), transparent 70%),
        linear-gradient(180deg, #0b5bd3 0%, var(--blue-fn) 52%, #5a9bff 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero { transform: none; }
  }

  /* --- The header's button while the hero's is on screen (script above) --- */
  :global(.site-header__cta) {
    transition: opacity 220ms var(--ease), visibility 0s linear 0s;
  }

  :global(html.hero-cta-in .site-header__cta) {
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms var(--ease), visibility 0s linear 220ms;
  }

  /* --- The facts: four reasons as a row of the grid under the hero ------------ */
  .facts-wrap {
    position: relative;
    margin-block-start: var(--s2);
  }

  .fact {
    align-content: start;
    gap: 0.5rem;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
  }

  .fact__link {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  /* The cell is the link's box, so the whole cell answers. */
  .fact__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .fact__link:focus-visible { outline: none; }

  .fact:has(.fact__link:focus-visible) {
    outline: 2px solid var(--accent-fn);
    outline-offset: -4px;
  }

  .fact:has(.fact__link:focus-visible)::before { transform: scaleX(1); }

  .fact__v {
    display: block;
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: var(--weight-medium);
    color: var(--fg);
    text-wrap: balance;
    transition: color 220ms var(--ease);
  }

  .fact.cell--link:hover .fact__v,
  .fact.cell--link:active .fact__v,
  .fact:has(.fact__link:focus-visible) .fact__v {
    color: var(--accent-fn);
  }

  .fact.cell--link:hover .cell__go { transform: translateX(4px); }

  .fact__b {
    display: block;
    max-inline-size: 30ch;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  /* Each value develops in dots once as the page opens, one after another. */
  :global(.reveal) .fact__v.print-now {
    --print-dur: 520ms;
    animation-delay: calc(240ms + var(--i, 0) * 90ms);
  }

  :global(html.motion-off) .fact__v.print-now {
    animation: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  @media (max-width: 39.99rem) {
    .fact { padding-block: 1.25rem; }
  }

  /* --- This page, measured: the fourth "fits" cell ----------------------------- */
  .proof {
    align-content: space-between;
    gap: 1.5rem;
  }

  .proof__list {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .proof__fig {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 0.6rem;
    border-block-end: 1px solid var(--rail);
  }

  .proof__fig dt {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .proof__fig dd {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .proof__fig dd span {
    margin-inline-start: 0.15em;
    font-size: 0.45em;
    letter-spacing: 0;
    color: var(--fg-muted);
  }

  .proof__note {
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
    color: var(--fg);
    transition: color 220ms var(--ease);
  }

  .proof:hover .proof__note,
  .proof:focus-visible .proof__note,
  .proof:active .proof__note { color: var(--accent-fn); }

  .proof:hover .cell__go { transform: translateX(4px); }

  /* --- Process: a line draws through the four steps as they scroll by ---------- */
  /* At rest (no scroll timelines, reduced motion, the Animation switch off)
     the line is complete and every number box is filled: the finished
     drawing, never a half state. */
  .steps {
    position: relative;
    view-timeline: --steps block;
  }

  .steps::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: -1px 0 auto;
    block-size: 2px;
    background: var(--accent-fn);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  .steps .step__n {
    background: var(--accent-fn);
    color: var(--bg);
  }

  @supports (animation-timeline: view()) {
    /* Wide: one line along the row's top edge; each box fills as the line
       reaches it (the same timeline, a later slice of it per step). */
    :global(.reveal) .steps::after {
      animation: steps-line linear both;
      animation-timeline: --steps;
      animation-range: cover 12% cover 45%;
    }

    :global(.reveal) .steps .step__n {
      animation: step-fill linear both;
      animation-timeline: --steps;
      animation-range: cover calc(12% + var(--k, 0) * 8.25%) cover calc(14% + var(--k, 0) * 8.25%);
    }

    /* Two columns or one: no single row to draw along, so each box fills
       as its own step comes up the screen. */
    @media (max-width: 60rem) {
      :global(.reveal) .steps::after { animation: none; display: none; }

      :global(.reveal) .steps .step__n {
        animation-timeline: view();
        animation-range: entry 60% cover 35%;
      }
    }

    :global(html.motion-off) .steps::after,
    :global(html.motion-off) .steps .step__n { animation: none; }
  }

  @keyframes steps-line {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes step-fill {
    from { background: transparent; color: var(--accent-fn); }
    to { background: var(--accent-fn); color: var(--bg); }
  }

</style>
