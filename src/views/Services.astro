---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Accent from '../components/Accent.astro';
import Illo from '../components/Illo.astro';
import Closing from '../components/Closing.astro';
import { useTranslations, route, type Lang } from '../i18n/ui';
import { PRICING, euros } from '../data/pricing';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const eur = (amount: number) => euros(amount, lang);
const from = (amount: number) => `${t('services.pricing.from')} ${eur(amount)}`;

/* Pricing is one offer and the plan that follows it, then the extras — not a
   price per service. A list with one row per discipline asks a salon owner to
   work out which rows apply to them; this says what the one project includes,
   what keeping it running costs, and what can go on top. The figures come
   from src/data/pricing.ts, so a price changes in one place. */
const designIncludes = [
  t('services.design.i1'),
  t('services.design.i2'),
  t('services.design.i3'),
  t('services.design.i4'),
  t('services.design.i5'),
  t('services.design.i6'),
  t('services.design.i7'),
  t('services.design.i8'),
];

const careIncludes = [
  t('services.care.i1'),
  t('services.care.i2'),
  t('services.care.i3'),
  t('services.care.i4'),
  t('services.care.i5'),
  t('services.care.i6'),
];

const addons = [
  {
    name: t('services.addons.pages'),
    price: t('services.pricing.perPage', { price: eur(PRICING.addons.page) }),
  },
  { name: t('services.addons.language'), price: from(PRICING.addons.language) },
  { name: t('services.addons.brand'), price: from(PRICING.addons.brand) },
  { name: t('services.addons.email'), price: from(PRICING.addons.email) },
  { name: t('services.addons.automation'), price: from(PRICING.addons.automation) },
];

/* Written out rather than built with t(`svc.${key}.name` as any). The cast
   was quietly removing static key-checking from all 25 svc.* strings — a
   typo in one would have rendered nothing rather than failing. */
const services = [
  {
    id: 'web',
    name: t('svc.web.name'), body: t('svc.web.body'),
    d: [t('svc.web.d1'), t('svc.web.d2'), t('svc.web.d3')],
  },
  {
    id: 'brand',
    name: t('svc.brand.name'), body: t('svc.brand.body'),
    d: [t('svc.brand.d1'), t('svc.brand.d2'), t('svc.brand.d3')],
  },
  {
    id: 'seo',
    name: t('svc.seo.name'), body: t('svc.seo.body'),
    d: [t('svc.seo.d1'), t('svc.seo.d2'), t('svc.seo.d3')],
  },
  {
    id: 'email',
    name: t('svc.email.name'), body: t('svc.email.body'),
    d: [t('svc.email.d1'), t('svc.email.d2'), t('svc.email.d3')],
  },
  {
    id: 'hosting',
    name: t('svc.hosting.name'), body: t('svc.hosting.body'),
    d: [t('svc.hosting.d1'), t('svc.hosting.d2'), t('svc.hosting.d3')],
  },
] as const;

/* The questions a small business actually asks a studio, and the answers.
   Most answers restate commitments made elsewhere on the site. The two that
   quote a price take it from src/data/pricing.ts, so an answer can never
   disagree with the price card above it. Drafts, written 2026-09-24. */
const faqs = [
  { q: t('services.faq.q1'), a: t('services.faq.a1') },
  { q: t('services.faq.q2'), a: t('services.faq.a2') },
  { q: t('services.faq.q3'), a: t('services.faq.a3') },
  { q: t('services.faq.q4'), a: t('services.faq.a4') },
  { q: t('services.faq.q5'), a: t('services.faq.a5', { price: eur(PRICING.addons.language) }) },
  { q: t('services.faq.q6'), a: t('services.faq.a6') },
  { q: t('services.faq.q7'), a: t('services.faq.a7', { price: eur(PRICING.care) }) },
];
---

<Base lang={lang} page="services" title={t('services.title')} description={t('services.lead')}>
  <PageHead title={t('services.h1')} lead={t('services.lead')} figure="services" />

  {/* --- What things cost -------------------------------------------------
      First on the page, because it is the question a referral arrives with.
      Two cards (David, 2026-10-14: the flat, divided version lacked contrast
      and hierarchy): the project on the dark ground, where the eye lands
      first, and the care that follows it on raised paper, a step quieter.
      Each ends in its own way to act. The extras sit in a panel under them.
      The id is what the home page links to. */}
  <section class="pricing rails" id="pricing">
    <div class="container">
      <div class="pricing__head">
        <h2><Accent text={t('services.pricing.h2')} /></h2>
        <p class="lead measure">{t('services.pricing.lead')}</p>
      </div>

      <div class="plans">
        <article class="plan plan--design invert">
          <p class="plan__kind">{t('services.design.kind')}</p>
          <h3 class="plan__name">{t('services.design.name')}</h3>
          {/* Both spans on ONE line with a real space between them. Astro's
              HTML compression deletes whitespace that crosses a line break, so
              the gap then existed only in CSS, and the text itself read
              "From€750" to anything that reads text rather than layout: copy
              and paste, search snippets, some screen readers. The flex gap
              still sets the visible spacing; the space is for everything else. */}
          <p class="plan__price">
            <span class="plan__unit">{t('services.pricing.from')}</span> <span class="plan__amount">{eur(PRICING.design)}</span>
          </p>
          <p class="plan__note">{t('services.design.note')}</p>
          <h4 class="plan__includes">{t('services.pricing.includes')}</h4>
          <ul class="plan__list">
            {designIncludes.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn plan__cta" href={route('contact', lang)}>{t('home.cta')}</a>
        </article>

        <article class="plan plan--care">
          <p class="plan__kind">{t('services.care.kind')}</p>
          <h3 class="plan__name">{t('services.care.name')}</h3>
          <p class="plan__price">
            <span class="plan__amount">{eur(PRICING.care)}</span> <span class="plan__unit">{t('services.pricing.perMonth')}</span>
          </p>
          <p class="plan__note">{t('services.care.note')}</p>
          <h4 class="plan__includes">{t('services.pricing.includes')}</h4>
          <ul class="plan__list">
            {careIncludes.map((item) => <li>{item}</li>)}
          </ul>
          <p class="plan__note">{t('services.care.small')}</p>
          <a class="btn btn--quiet plan__cta" href={route('contact', lang)}>{t('services.care.cta')}</a>
        </article>
      </div>

      <div class="addons">
        <div>
          <h3 class="addons__h">{t('services.addons.h')}</h3>
          <p class="addons__lead">{t('services.addons.lead')}</p>
        </div>
        <dl class="addons__list">
          {
            addons.map((a) => (
              <div class="addon">
                <dt>{a.name}</dt>
                <dd class="addon__price">{a.price}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* --- What each part covers --------------------------------------------
      The five disciplines behind the prices above, each with its own heading
      at near-display scale — not five identical cards in a grid with a stroke
      icon at the top. The old site had six of those and they were the reason
      every page read the same. The number column doubles as the section's
      own index, and each id is what a home-page lane links to. */}
  <div class="services rails">
    <div class="container">
      <div class="services__head">
        <h2>{t('services.detail.h2')}</h2>
      </div>

      {
        services.map((s, i) => (
          <section class:list={['svc', 'row', i === 1 && 'invert']} id={s.id} data-illo-zone>
            <div class="svc__index row__title">
              {/* The service's icon on its soft wash, filling the column that
                  used to run empty beside the copy (David, 2026-10-12).
                  Only the wash at rest; the sticker appears on hover. It
                  lives inside the sticky block, so it travels with the
                  number. Decorative: the heading opposite says everything. */}
              <div class="icon-wash svc__art" aria-hidden="true">
                <Illo name={s.id} variant="icon" />
              </div>
            </div>

            <div class="svc__body row__body">
              <h3 class="svc__name">{s.name}</h3>
              <p class="svc__lede">{s.body}</p>

              <h4 class="svc__deliverables-h">{t('services.deliverables')}</h4>
              <ul class="svc__deliverables">
                {s.d.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  {/* --- FAQ ---------------------------------------------------------------
      <details>/<summary>, so it opens and closes with no JavaScript at all
      and arrives keyboard-accessible with its expanded state announced. The
      site ships one 12 KB script; an accordion is not worth adding to it. */}
  <section class="faq rails">
    <div class="container">
      <div class="faq__head">
        <h2>{t('services.faq.h2')}</h2>
        <Illo name="question" variant="aside" />
      </div>

      <div class="faqs">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary class="faq-item__q">{f.q}</summary>
              <div class="faq-item__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Closing lang={lang} />
</Base>

<style>
  /* --- What things cost --------------------------------------------------- */

  /* The first section after the page head: a shorter step down than the
     rhythm between sections, and no rule above it any more. */
  .pricing {
    padding-block-start: var(--s5);
  }

  .pricing__head {
    display: grid;
    gap: var(--s3);
    margin-block-end: var(--s5);
  }

  /* The project and the care that follows it, side by side, the project the
     wider of the two. Two surfaces instead of one dividing rule: the dark
     card (.invert, so every role inside flips) and the raised paper card with
     an edge. Square, no shadow, like every surface on the site. Stretched to
     one height so the two buttons line up at the bottom. */
  .plans {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: stretch;
    gap: var(--s3);
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: clamp(var(--s4), 3vw, var(--s5));
  }

  .plan--care {
    background: var(--paper-hi);
    border: 1px solid var(--rail);
  }

  .plan__kind {
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
  }

  .plan__name {
    font-size: var(--t-h3);
    line-height: 1.15;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s1) var(--s2);
  }

  /* The project's number at h2 scale and the care plan's a step below it,
     both in the heading weight with tabular figures: the price is the thing
     on this page people came for, so it is the heaviest type on it. */
  .plan__amount {
    font-size: var(--t-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tr-display);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .plan__unit {
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .plan__note {
    max-width: 52ch;
    font-size: var(--t-body);
    color: var(--fg-muted);
  }

  /* Space, not a hairline, splits the card into its offer and its contents. */
  .plan__includes {
    margin-block-start: var(--s3);
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
  }

  .plan__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  /* Eight items as one column run long beside the care plan's six; two
     columns keep the two cards roughly the same height. */
  .plan--design .plan__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s4);
  }

  /* The way to act, pinned to the card's foot so both line up; the card's
     gap keeps it clear of the list when the card is at its natural height. */
  .plan__cta {
    align-self: flex-start;
    margin-block-start: auto;
  }

  /* On the dark card the button keeps the light-ground fill. Inside .invert
     --accent-fn becomes --on-ink-blue, and white on that is 2.9:1; --blue-fn
     carries white at 5.47:1, and the hover fill at 7.63:1. */
  .plan--design .plan__cta {
    --btn-bg: var(--blue-fn);
  }

  .plan--design .plan__cta:hover,
  .plan--design .plan__cta:focus-visible {
    --btn-bg: var(--blue-hover);
  }

  /* --- Extras ------------------------------------------------------------- */

  /* A panel on the same raised paper as the care card: what the extras are on
     the left, the list on the right, each price in the heading weight so it
     reads as a price and not as a footnote. */
  .addons {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--s3) var(--s5);
    margin-block-start: var(--s3);
    padding: clamp(var(--s4), 3vw, var(--s5));
    background: var(--paper-hi);
    border: 1px solid var(--rail);
  }

  .addons__h {
    font-size: var(--t-h3);
  }

  .addons__lead {
    margin-block-start: var(--s2);
    font-size: var(--t-body);
    color: var(--fg-muted);
  }

  .addons__list {
    margin: 0;
    display: grid;
  }

  /* One row per extra, the name left and the price right, separated by
     space alone. */
  .addon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s1) var(--s3);
    padding-block: 0.8rem;
  }

  .addon:first-child {
    padding-block-start: 0;
  }

  .addon:last-child {
    padding-block-end: 0;
  }

  .addon dt {
    font-weight: var(--weight-medium);
  }

  .addon__price {
    margin: 0;
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* --- What each part covers ---------------------------------------------- */

  .services {
    padding-block-start: var(--section-y);
  }

  .services__head {
    margin-block-end: var(--s5);
  }

  /* --- FAQ ---------------------------------------------------------------- */

  .faq {
    padding-block-start: var(--section-y);
  }

  /* The heading with the question-mark sticker beside it, at its 1x width
     (244px). On a phone the sticker is hidden (global.css). */
  .faq__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 244px);
    align-items: center;
    gap: var(--s5);
    margin-block-end: var(--s5);
  }

  @media (max-width: 59.99rem) {
    .faq__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .faqs {
    max-width: var(--width-text);
  }

  /* list-style and the webkit marker both have to go, or the browser draws its
     own triangle next to ours. */
  .faq-item__q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding-block: var(--s3);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: var(--tr-heading);
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q::after {
    content: '+';
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--t-body);
    /* --accent-fn, not --accent: this is a small graphic carrying state, and
       the display blue is 3.97:1. */
    color: var(--accent-fn);
  }

  .faq-item[open] .faq-item__q::after {
    content: '\2212';
  }

  .faq-item__a {
    padding-block-end: var(--s4);
    max-width: var(--measure);
    color: var(--fg-muted);
  }

  .svc {
    padding-block: var(--s6);
  }

  /* One row per list runs dark, which is the CREATIVE. reference's device for
     giving a long list a rhythm without turning a whole section into a band.
     Dark is the footer's ground everywhere else on this site now; here it is
     punctuation.

     The negative margin with matching padding is what keeps the type on this
     row aligned with every other row while the fill sits slightly proud of
     the content column. The alternative — padding without the margin —
     indents one row's text by 32px and reads as a mistake.

     Every role inside flips automatically: .invert reassigns --fg, --fg-muted,
     --accent, --rule and --rail in one place, so .row__body's divider and the
     index numeral follow without a single override here. */
  .svc.invert {
    /* Clamped to the gutter. A flat --s4 bleed is 32px, and at 320px the
       gutter is only 20px — the row then hangs 12px off each side of the page
       and the document scrolls sideways. */
    margin-inline: calc(min(var(--s4), var(--gutter)) * -1);
    padding-inline: min(var(--s4), var(--gutter));
  }

  /* The index stays with the heading as the section scrolls past, so a long
     services page never loses track of which service you are reading. */
  .svc__index {
    position: sticky;
    top: var(--header-h);
    align-self: start;
  }

  /* Sized to the title track: the cell follows the viewport so the art
     fills the column (David: bigger, with good details of the object).
     Below 60rem the column collapses into the flow, so the icon goes the
     way the home lanes' art does. */
  /* The sticker sits in the title column at up to its own 1x width. */
  .svc__art {
    --illo-w: 224px;
  }

  @media (max-width: 60rem) {
    .svc__art {
      display: none;
    }
  }

  .svc__body {
    max-width: 58rem;
  }

  /* An h3 now that the section has its own head above the rows — held at the
     h2 weight it was drawn at, so the demotion changes the document outline
     and nothing a reader sees. */
  .svc__name {
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: var(--weight-heading);
    line-height: 1.04;
  }

  .svc__lede {
    margin-block-start: var(--s3);
    max-width: var(--measure);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .svc__deliverables-h {
    margin-block-start: var(--s5);
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
  }

  .svc__deliverables {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s3);
    display: grid;
    gap: 0.6rem;
    max-width: var(--measure);
  }

  .svc__deliverables li,
  .plan__list li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: var(--t-body);
  }

  /* A square in the accent for the deliverables: one device rather than
     bespoke stroke icons. */
  .svc__deliverables li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    background: var(--accent);
  }

  /* A check for what a plan includes: it answers "is this in the price?".
     --accent-fn, so it clears 3:1 on both cards (--blue-fn on paper, the
     on-ink blue on the dark card). */
  .plan__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.15rem;
    inset-block-start: 0.3em;
    inline-size: 0.38rem;
    block-size: 0.7rem;
    border: solid var(--accent-fn);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Matches the width the row primitive collapses at, so the index stops
     sticking at the same moment it stops having a column. The cards and the
     extras panel stack at the same width, in the same order. */
  @media (max-width: 60rem) {
    .svc {
      padding-block: var(--s5);
    }

    .svc__index {
      position: static;
    }

    .plans,
    .addons {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .plan--design .plan__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
