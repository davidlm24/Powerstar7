---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Illo from '../components/Illo.astro';
import Closing from '../components/Closing.astro';
import Faq from '../components/Faq.astro';
import { useTranslations, route, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
/* Written out rather than built with t(`svc.${key}.name` as any), so every
   key keeps its static check. Each service is explained the same four ways
   (2026-10-20, David): what it is, how we work, what you get, what we need
   from you. The home cards carry only svc.*.short, the first sentence. */
const services = [
  {
    id: 'web',
    name: t('svc.web.name'),
    what: [t('svc.web.what1'), t('svc.web.what2')],
    how: t('svc.web.how'),
    need: t('svc.web.need'),
    get: [t('svc.web.g1'), t('svc.web.g2'), t('svc.web.g3'), t('svc.web.g4'), t('svc.web.g5'), t('svc.web.g6')],
  },
  {
    id: 'brand',
    name: t('svc.brand.name'),
    what: [t('svc.brand.what1'), t('svc.brand.what2')],
    how: t('svc.brand.how'),
    need: t('svc.brand.need'),
    get: [t('svc.brand.g1'), t('svc.brand.g2'), t('svc.brand.g3'), t('svc.brand.g4')],
  },
  {
    id: 'seo',
    name: t('svc.seo.name'),
    what: [t('svc.seo.what1'), t('svc.seo.what2')],
    how: t('svc.seo.how'),
    need: t('svc.seo.need'),
    get: [t('svc.seo.g1'), t('svc.seo.g2'), t('svc.seo.g3'), t('svc.seo.g4'), t('svc.seo.g5')],
  },
  {
    id: 'email',
    name: t('svc.email.name'),
    what: [t('svc.email.what1'), t('svc.email.what2')],
    how: t('svc.email.how'),
    need: t('svc.email.need'),
    get: [t('svc.email.g1'), t('svc.email.g2'), t('svc.email.g3'), t('svc.email.g4')],
  },
  {
    id: 'hosting',
    name: t('svc.hosting.name'),
    what: [t('svc.hosting.what1'), t('svc.hosting.what2')],
    how: t('svc.hosting.how'),
    need: t('svc.hosting.need'),
    get: [t('svc.hosting.g1'), t('svc.hosting.g2'), t('svc.hosting.g3'), t('svc.hosting.g4'), t('svc.hosting.g5'), t('svc.hosting.g6')],
  },
] as const;

/* The questions about working with us: how long, what we need, editing it
   yourself, and what accessible means. The ones about money, leaving and a
   language that costs extra moved to the Pricing page. */
const faqs = [
  { q: t('services.faq.q1'), a: t('services.faq.a1') },
  { q: t('services.faq.q2'), a: t('services.faq.a2') },
  { q: t('services.faq.q3'), a: t('services.faq.a3') },
  { q: t('services.faq.q6'), a: t('services.faq.a6') },
];
---

<Base lang={lang} page="services" title={t('services.title')} description={t('services.lead')} dither>
  <PageHead title={t('services.h1')} lead={t('services.lead')} />

  {/* --- The five services, explained -------------------------------------
      Each with its own heading at near-display scale — not five identical
      cards in a grid with a stroke icon at the top. The old site had six of
      those and they were the reason every page read the same. The icon
      column doubles as the section's index, and each id is what a home-page
      card links to. */}
  <div class="services rails">
    <div class="container">

      {
        services.map((s, i) => (
          <section class:list={['svc', 'row', i === 1 && 'invert']} id={s.id} data-illo-zone>
            <div class="svc__index row__title">
              {/* The service's icon on its soft wash, filling the column that
                  used to run empty beside the copy (David, 2026-10-12),
                  at full strength since 2026-10-19. It lives inside the
                  sticky block, so it travels with the row. Decorative: the
                  heading opposite says everything. */}
              <div class="icon-wash svc__art" aria-hidden="true">
                <Illo name={s.id} variant="icon" ink={i === 1 ? 'on-ink' : 'blue'} />
              </div>
            </div>

            <div class="svc__body row__body">
              <h3 class="svc__name">{s.name}</h3>
              <h4 class="visually-hidden">{t('services.what.h')}</h4>
              <p class="svc__lede">{s.what[0]}</p>
              <p class="svc__p">{s.what[1]}</p>

              <div class="svc__cols">
                <div>
                  <h4 class="svc__h">{t('services.how.h')}</h4>
                  <p class="svc__p">{s.how}</p>
                  <h4 class="svc__h svc__h--next">{t('services.need.h')}</h4>
                  <p class="svc__p">{s.need}</p>
                </div>
                <div>
                  <h4 class="svc__h">{t('services.deliverables')}</h4>
                  <ul class="svc__get">
                    {s.get.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <a class="svc__price" href={route('pricing', lang)}>{t('services.price.link')} <span aria-hidden="true">&rarr;</span></a>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <Faq lang={lang} heading={t('services.faq.h2')} items={faqs} aside />

  <Closing lang={lang} />
</Base>

<style>
  /* --- What each part covers ---------------------------------------------- */

  .services {
    padding-block-start: var(--s4);
  }

  .svc {
    padding-block: var(--s6);
  }

  /* One row per list runs dark, which is the CREATIVE. reference's device for
     giving a long list a rhythm without turning a whole section into a band.
     Dark is the footer's ground everywhere else on this site now; here it is
     punctuation.

     The negative margin with matching padding is what keeps the type on this
     row aligned with every other row while the fill sits slightly proud of
     the content column. The alternative — padding without the margin —
     indents one row's text by 32px and reads as a mistake.

     Every role inside flips automatically: .invert reassigns --fg, --fg-muted,
     --accent, --rule and --rail in one place, so .row__body's divider and the
     index numeral follow without a single override here. */
  .svc.invert {
    border-radius: var(--radius);
    /* Clamped to the gutter. A flat --s4 bleed is 32px, and at 320px the
       gutter is only 20px — the row then hangs 12px off each side of the page
       and the document scrolls sideways. */
    margin-inline: calc(min(var(--s4), var(--gutter)) * -1);
    padding-inline: min(var(--s4), var(--gutter));
  }

  /* The index stays with the heading as the section scrolls past, so a long
     services page never loses track of which service you are reading. */
  .svc__index {
    position: sticky;
    top: var(--header-h);
    align-self: start;
  }

  /* Sized to the title track: the cell follows the viewport so the art
     fills the column (David: bigger, with good details of the object).
     Below 60rem the column collapses into the flow, so the icon goes the
     way the home lanes' art does. */
  /* The sticker sits in the title column at up to its own 1x width. */
  .svc__art {
    --illo-w: 224px;
  }

  @media (max-width: 60rem) {
    .svc__art {
      display: none;
    }
  }

  .svc__body {
    max-width: 58rem;
  }

  /* An h3 now that the section has its own head above the rows — held at the
     h2 weight it was drawn at, so the demotion changes the document outline
     and nothing a reader sees. */
  .svc__name {
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: var(--weight-heading);
    line-height: 1.04;
  }

  .svc__lede {
    margin-block-start: var(--s3);
    max-width: var(--measure);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  /* The second paragraph and the body of each block, a step quieter than
     the lede. */
  .svc__p {
    margin-block-start: var(--s2);
    max-width: var(--measure);
    font-size: var(--t-body);
    color: var(--fg-muted);
  }

  /* How we work and what we need beside what you get, two columns where
     there is room. */
  .svc__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4) var(--s5);
    margin-block-start: var(--s5);
  }

  .svc__h {
    font-size: var(--t-small);
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
  }

  .svc__h--next {
    margin-block-start: var(--s4);
  }

  .svc__cols .svc__p {
    margin-block-start: var(--s1);
  }

  .svc__get {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s2);
    display: grid;
    gap: 0.6rem;
  }

  .svc__get li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: var(--t-body);
  }

  .svc__price {
    display: inline-block;
    margin-block-start: var(--s4);
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
  }

  /* A square in the accent for what you get: one device rather than
     bespoke stroke icons. */
  .svc__get li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    background: var(--accent);
  }

  /* Matches the width the row primitive collapses at, so the index stops
     sticking at the same moment it stops having a column. */
  @media (max-width: 60rem) {
    .svc {
      padding-block: var(--s5);
    }

    .svc__index {
      position: static;
    }
  }

  @media (max-width: 48rem) {
    .svc__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
