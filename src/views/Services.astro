---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Closing from '../components/Closing.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { id: 'web', n: '01', key: 'web' },
  { id: 'brand', n: '02', key: 'brand' },
  { id: 'seo', n: '03', key: 'seo' },
  { id: 'email', n: '04', key: 'email' },
  { id: 'hosting', n: '05', key: 'hosting' },
] as const;
---

<Base lang={lang} page="services" title={t('services.title')} description={t('services.lead')}>
  <PageHead label={t('home.services.label')} title={t('services.h1')} lead={t('services.lead')} />

  {/* Five sections, each with its own heading at near-display scale — not
      five identical cards in a grid with a stroke icon at the top. The old
      site had six of those and they were the reason every page read the
      same. The number column doubles as the section's own index. */}
  <div class="services rails">
    <div class="container">
      {
        services.map((s, i) => (
          <section class:list={['svc', 'row', i === 1 && 'invert']} id={s.id}>
            <div class="svc__index row__title">
              <span class="svc__n">{s.n}</span>
            </div>

            <div class="svc__body row__body">
              <h2 class="svc__name">{t(`svc.${s.key}.name` as any)}</h2>
              <p class="svc__lede">{t(`svc.${s.key}.body` as any)}</p>

              <h3 class="svc__deliverables-h">{t('services.deliverables')}</h3>
              <ul class="svc__deliverables">
                <li>{t(`svc.${s.key}.d1` as any)}</li>
                <li>{t(`svc.${s.key}.d2` as any)}</li>
                <li>{t(`svc.${s.key}.d3` as any)}</li>
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <Closing lang={lang} />
</Base>

<style>
  .services {
    padding-block-end: var(--s7);
  }

  .svc {
    padding-block: var(--s6);
    border-top: 1px solid var(--rule);
  }

  /* One row per list runs dark, which is the CREATIVE. reference's device for
     giving a long list a rhythm without turning a whole section into a band.
     Dark is the footer's ground everywhere else on this site now; here it is
     punctuation.

     The negative margin with matching padding is what keeps the type on this
     row aligned with every other row while the fill sits slightly proud of
     the content column. The alternative — padding without the margin —
     indents one row's text by 32px and reads as a mistake.

     Every role inside flips automatically: .invert reassigns --fg, --fg-muted,
     --accent, --rule and --rail in one place, so .row__body's divider and the
     index numeral follow without a single override here. */
  .svc.invert {
    /* Clamped to the gutter. A flat --s4 bleed is 32px, and at 320px the
       gutter is only 20px — the row then hangs 12px off each side of the page
       and the document scrolls sideways. */
    margin-inline: calc(min(var(--s4), var(--gutter)) * -1);
    padding-inline: min(var(--s4), var(--gutter));
    border-top-color: transparent;
  }

  /* The index stays with the heading as the section scrolls past, so a long
     services page never loses track of which service you are reading. */
  .svc__index {
    position: sticky;
    top: var(--header-h);
    align-self: start;
  }

  .svc__n {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tr-mono);
    /* --accent-fn, not --accent. This is 13px text, and the bright display
       blue measures 3.97:1 on the ground — it fails AA below 24px. That is
       the entire reason the accent ships as a pair. */
    color: var(--accent-fn);
  }

  .svc__body {
    max-width: 58rem;
  }

  .svc__name {
    font-size: clamp(1.875rem, 4vw, 3rem);
    line-height: 1.04;
  }

  .svc__lede {
    margin-block-start: var(--s3);
    max-width: var(--measure);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .svc__deliverables-h {
    margin-block-start: var(--s5);
    font-family: var(--font-text);
    font-size: var(--t-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .svc__deliverables {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s3);
    display: grid;
    gap: 0.6rem;
    max-width: var(--measure);
  }

  .svc__deliverables li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: var(--t-small);
  }

  /* A square in the accent, the same mark the section labels use. One device,
     reused — rather than six bespoke stroke icons. */
  .svc__deliverables li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    background: var(--accent);
  }

  /* Matches the width the row primitive collapses at, so the index stops
     sticking at the same moment it stops having a column. */
  @media (max-width: 60rem) {
    .svc {
      padding-block: var(--s5);
    }

    .svc__index {
      position: static;
    }
  }
</style>
