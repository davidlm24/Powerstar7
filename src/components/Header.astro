---
import { useTranslations, route, alternate, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page?: PageKey;
  /** A "Start a project" button in the bar (the theme trial). */
  cta?: boolean;
  /** The light/dark button (theme="switch" on Base). */
  themeToggle?: boolean;
}

const { lang, page, cta = false, themeToggle = false } = Astro.props;
const t = useTranslations(lang);
const other = alternate(page ?? 'home', lang);

const items: { key: PageKey; label: string }[] = [
  { key: 'home', label: t('nav.home') },
  { key: 'work', label: t('nav.work') },
  { key: 'services', label: t('nav.services') },
  { key: 'pricing', label: t('nav.pricing') },
  { key: 'about', label: t('nav.about') },
  { key: 'contact', label: t('nav.contact') },
];
---

{/* No bar at the top: the wordmark and the nav sit straight on the page,
    and a hero's background runs up behind them. Once the page moves, the
    header becomes frosted glass: a paper tint over a blur, with the rail
    hairline under it (David, 2026-10-19, replacing the opaque header).

    The glass is full width and has no inset edge, so there is no second
    rectangle for the blur's clip to draw. The tint is 78% paper, which keeps
    the nav above AA even over the dark footer: ink on 78% paper over
    --ink-deep measures about 9.7:1. Where blur is unsupported, or less
    transparency is asked for, the tint goes opaque. */}
<header class="site-header rails">
  <div class="container site-header__row">
    <a class="wordmark" href={route('home', lang)} aria-label={t('nav.homeLabel')}>
      DesignActiv<span class="wordmark__dot" aria-hidden="true">.</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t('nav.open')}
      data-label-open={t('nav.open')}
      data-label-close={t('nav.close')}
    >
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="nav-toggle__text">{t('nav.menu')}</span>
    </button>

    <nav class="nav" id="site-nav" data-open="false" aria-label={t('nav.menu')}>
      <ul class="nav__list">
        {
          items.map((item) => (
            <li>
              <a
                href={route(item.key, lang)}
                aria-current={item.key === page ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Just the code, but the accessible name has to CONTAIN the visible
          text — WCAG 2.5.3 Label in Name, so that someone saying "click PT"
          to a voice control actually hits this link. Announcing only "Ver em
          português" while showing "PT" fails that. */}
      <a
        class="nav__lang"
        href={other.href}
        lang={other.lang}
        hreflang={other.lang}
        aria-label={`${other.lang.toUpperCase()} — ${t('nav.langSwitch')}`}
      >
        {other.lang.toUpperCase()}
      </a>
    </nav>

    {
      themeToggle && (
        <button
          type="button"
          class="site-header__theme"
          data-theme-toggle
          aria-pressed="false"
          aria-label={t('nav.theme.light')}
        >
          {/* Sun (shown in dark: "go light") and moon (shown in light). */}
          <svg class="theme-ico theme-ico--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" fill="currentColor" />
            <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <svg class="theme-ico theme-ico--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor" />
          </svg>
        </button>
      )
    }

    {cta && <a class="btn btn--sm site-header__cta" href={route('contact', lang)}>{t('home.cta')}</a>}

    {
      themeToggle && (
        <script is:inline>
          (function () {
            var btn = document.querySelector('[data-theme-toggle]');
            if (!btn) return;
            var h = document.documentElement;
            var sync = function () {
              var light = h.classList.contains('theme-light');
              btn.setAttribute('aria-pressed', String(light));
              /* One constant name ("Light theme"); aria-pressed carries the state. */
            };
            sync();
            /* The swap itself: classes, the browser bar colour, the saved
               choice, the button's state, then the event (canvases redraw
               on it, so they are already new when the snapshot is taken). */
            var apply = function (light) {
              h.classList.toggle('theme-light', light);
              h.classList.toggle('theme-dark', !light);
              var meta = document.querySelector('meta[name="theme-color"]');
              if (meta) meta.setAttribute('content', light ? '#f9f9f9' : '#0e0e0c');
              try { localStorage.setItem('designactiv-theme', light ? 'light' : 'dark'); } catch (e) {}
              sync();
              window.dispatchEvent(new Event('themechange'));
            };
            var still = function () {
              return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
            };
            var fade = 0;
            btn.addEventListener('click', function () {
              var light = !h.classList.contains('theme-light');
              /* Less motion asked for: the swap is instant. */
              if (still()) { apply(light); return; }
              /* View Transitions: the new theme grows out of the button as a
                 circle until it covers the farthest corner (themes.css turns
                 the default cross-fade off). */
              if (typeof document.startViewTransition === 'function') {
                var r = btn.getBoundingClientRect();
                var x = r.left + r.width / 2;
                var y = r.top + r.height / 2;
                var R = Math.ceil(Math.hypot(
                  Math.max(x, window.innerWidth - x),
                  Math.max(y, window.innerHeight - y)
                ));
                var at = ' at ' + x + 'px ' + y + 'px)';
                var vt = document.startViewTransition(function () { apply(light); });
                vt.ready.then(function () {
                  h.animate(
                    { clipPath: ['circle(0px' + at, 'circle(' + R + 'px' + at] },
                    { duration: 480, easing: 'cubic-bezier(.2,.7,.2,1)', pseudoElement: '::view-transition-new(root)' }
                  );
                }).catch(function () {});
                return;
              }
              /* No View Transitions: a short colour ease on everything, for
                 the moment of the swap only. */
              clearTimeout(fade);
              h.classList.add('theme-switching');
              apply(light);
              fade = setTimeout(function () { h.classList.remove('theme-switching'); }, 340);
            });
          })();
        </script>
      )
    }
  </div>
</header>

<style>
  /* The theme button: an icon, a 44px target, a quiet ring on hover. */
  .site-header__theme {
    display: inline-grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .site-header__theme:hover {
    color: var(--fg);
    border-color: var(--rail);
  }

  .theme-ico--moon { display: none; }
  :global(.theme-light) .theme-ico--sun { display: none; }
  :global(.theme-light) .theme-ico--moon { display: block; }

  /* sticky, not relative: this beats .rails's own position: relative via
     Astro's scoping (0,2,0 against 0,1,0). Do not "simplify" it away — the
     header would un-stick. */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: transparent;
    /* Out of the flow: main gives the height back (global.css), and a hero
       pulls itself up under the header so its background shows through. */
    margin-block-end: calc(-1 * var(--header-h));
    /* 24 + 44 + 23 + 1px of border = 92px = --header-h, which is exactly what
       the old bar computed to, so every sticky offset and scroll-padding that
       reads that token stays where it was. */
    padding-block: var(--s3) calc(var(--s3) - 1px);
    /* A real border, transparent until scrolled — not a box-shadow. A
       hairline drawn in shadow is precisely what a line audit is supposed to
       catch, and this one has to sit beside 28 border-drawn hairlines without
       being a different kind of object. Always 1px, so nothing reflows when
       it colours in. */
    border-block-end: 1px solid transparent;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      backdrop-filter var(--dur) var(--ease);
  }

  /* The same line the page edges draw, 1.22:1. There is no tint to fail
     contrast now: the nav reads --fg at 15.41:1 and --fg-muted at 7.13:1
     against an opaque ground, whatever is scrolled underneath. That is the
     real prize here — the header's contrast stops being a function of page
     content, which is what the three deleted fences were all working around. */
  .site-header.is-stuck {
    border-block-end-color: var(--rail);
    background-color: color-mix(in srgb, var(--paper) 78%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header.is-stuck { background-color: var(--paper); }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header.is-stuck { background-color: var(--paper); }
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    min-block-size: 2.75rem;
  }

  /* --- Wordmark ---------------------------------------------------------- */

  /* --weight-medium, not --weight-display. The display weight is 400 now, and
     at 20px that is a ghost — it would sit at the same apparent weight as the
     body copy beside it. 500 is the floor that keeps a wordmark reading as a
     wordmark. */
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.03em;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }

  /* The only ornament that survived the rebuild: a full stop in the accent.
     It is one character, it carries the brand colour, and it costs nothing. */
  /* --accent-fn, not --accent, and the weight change is why. At 700 this dot
     was LARGE text — 20px at >=18.66px/700 — so 3:1 applied and the display
     blue's 3.97:1 passed. At 500 it stops being large text, the bar becomes
     4.5:1, and the same colour fails. The functional sibling is 4.89:1. */
  .wordmark__dot {
    color: var(--accent-fn);
  }

  /* --- Navigation -------------------------------------------------------- */

  .nav {
    display: flex;
    align-items: center;
    gap: var(--s5);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--s4);
    list-style: none;
    padding: 0;
  }

  .nav__list a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--fg);
    font-size: var(--t-small);
    text-decoration: none;
    letter-spacing: -0.005em;
  }

  /* Underline on hover and on the current page — same device, so the current
     page reads as "you are here" rather than as a different kind of thing. */
  .nav__list a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .nav__list a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* No box, no border, no pill — two letters. The 44px tap target is kept
     with padding rather than with a visible frame. */
  .nav__lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    font-size: var(--t-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tr-micro);
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__lang:hover {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* --- Mobile ------------------------------------------------------------ */

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.75rem;
    /* Cancels the toggle's own inline padding, so the MENU label ends on the
       content edge and the button stays inside the rail (review GV-6). */
    margin-inline-end: -0.75rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: var(--t-micro);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
    color: var(--fg);
  }

  .nav-toggle__bars {
    display: grid;
    gap: 5px;
    inline-size: 20px;
  }

  .nav-toggle__bars span {
    display: block;
    block-size: 2px;
    background: currentColor;
    transition: transform var(--dur) var(--ease);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 60rem) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav {
      position: absolute;
      inset-inline: 0;
      /* Flush to the header's bottom edge. The old +var(--s1) was clearance
         from a floating bar, and there is no floating bar. */
      inset-block-start: 100%;
      max-height: calc(100svh - var(--header-h) - var(--s4));
      overflow-y: auto;
      z-index: 20;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      /* --gutter, not --s3: inset-inline: 0 resolves against .container's
         padding box now, so this lands the links on the content edge — i.e.
         framed by the rails. */
      padding: var(--s2) var(--gutter) var(--s3);
      /* OPAQUE, not a tint. The panel used to sit at 85% with a hard floor
         underneath it, because below that the muted language toggle stopped
         clearing 4.5:1 over a near-black band. An opaque panel cannot fail
         that at all: --fg is 15.41:1 and --fg-muted 7.13:1, whatever is
         behind. The floor, and the comment defending it, both go. */
      background: var(--bg);
      /* No backdrop-filter. The panel is opaque, so a blur behind it is a
         composited layer rendering something nobody can see. */
      /* No border. It was a four-sided frame around a floating panel — the
         shape the line direction retires — and it was drawn at 1.084:1, too
         faint to be an edge even where an edge was wanted. The shadow below
         was already doing that job on its own. */
      box-shadow: 0 16px 40px -24px rgb(17 19 24 / 0.5);
    }

    .nav[data-open='false'] {
      display: none;
    }

    /* No position override here. A sticky element is already a containing
       block for the absolutely positioned panel, and switching to relative
       would silently un-stick the header on exactly the devices where a
       reachable nav matters most. */

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    /* Block, so each row's divider runs the panel's full width. */
    .nav__list a {
      display: block;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--rule);
      font-size: var(--t-body);
    }

    .nav__lang {
      align-self: flex-start;
      margin-block-start: var(--s3);
    }
  }

  /* Without JavaScript the toggle cannot work, so the nav stays visible. */
  :global(html.no-js) .nav {
    display: flex !important;
  }

  :global(html.no-js) .nav-toggle {
    display: none !important;
  }

  /* The theme button needs its script; without it, it is not shown. */
  :global(html.no-js) .site-header__theme {
    display: none !important;
  }

  /* ...and on narrow screens it is a plain list under the wordmark, in the
     flow, with the header no longer sticky. As an absolute panel it sat over
     the hero and hid the heading, the lead and both buttons; sticky, it
     would have carried ~350px of links down the whole page. The header's
     negative margin-bottom only subtracts --header-h, so the extra height
     pushes the page down by exactly the list's height and nothing overlaps. */
  @media (max-width: 60rem) {
    :global(html.no-js) .site-header {
      position: static;
    }

    :global(html.no-js) .site-header__row {
      flex-wrap: wrap;
    }

    :global(html.no-js) .nav {
      position: static;
      flex: 1 1 100%;
      max-height: none;
      box-shadow: none;
      padding-inline: 0;
    }
  }
</style>
