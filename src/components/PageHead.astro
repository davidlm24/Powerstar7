---
import Illo, { type IlloName } from './Illo.astro';
import Accent from './Accent.astro';

interface Props {
  title: string;
  lead?: string;
  /** The page's illustration, drawn from what the page is about. */
  figure?: IlloName;
  /** A blinking cursor after the lead, for the page that asks you to type. */
  cursor?: boolean;
}

const { title, lead, figure, cursor } = Astro.props;
---

{/* The inner-page header: the headline and lead on the left, the page's
    sticker beside them at full strength. No label above the headline and no
    dotted row under it any more (David, 2026-10-14). Paper ground like
    everything else, and a step below the home hero (80px against 96px), so
    the home page stays the loudest thing on the site. */}
<section class="page-head rails">
  <div class="container page-head__grid">
    <div>
      <h1 class="page-head__h1"><Accent text={title} /></h1>
      {
        /* Either the string prop or a `lead` slot. The slot exists because a
           .pending placeholder is markup and cannot travel as a string. */
        (lead || Astro.slots.has('lead')) && (
          <p class="lead page-head__lead">
            {lead ?? <slot name="lead" />}{cursor && <span class="cursor" aria-hidden="true">_</span>}
          </p>
        )
      }
    </div>
    {figure && <Illo name={figure} variant="field" />}
  </div>
</section>

<style>
  .page-head {
    padding-block: var(--s6) var(--s5);
  }

  /* The sticker's column is its 1x width, 320px, so the dither stays crisp
     where there is room; it narrows with the page below that. */
  .page-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    align-items: center;
    gap: var(--s5);
  }

  .page-head__h1 {
    font-size: var(--t-title);
    font-weight: var(--weight-heading);
    max-width: 16ch;
  }

  .page-head__lead {
    margin-block-start: var(--s4);
    max-width: 52ch;
  }

  @media (max-width: 47.99rem) {
    .page-head__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
