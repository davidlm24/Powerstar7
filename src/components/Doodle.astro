---
/* A small ink mark near a section edge: a spark, a squiggle or a dot cluster.
   One or two per page, never more.

   The same grammar as Illustration.astro: an ink line over a flat blue shape
   that does not quite register with it, roughened by the filters in
   InkDefs.astro (rendered once per page by Base.astro).

   Decoration, by contract: aria-hidden, no text, and it sits in the margin of
   a section, clear of the content and the rails. The section must be
   positioned (every .rails section is). Hidden below 48rem, where the margin
   is too narrow to hold it without crowding the text. */

export type DoodleKind = 'spark' | 'squiggle' | 'dots';

interface Props {
  kind: DoodleKind;
  /** Which corner of the section: top-end, bottom-start, … */
  pos?: 'top-end' | 'top-start' | 'bottom-end' | 'bottom-start';
}

const { kind, pos = 'top-end' } = Astro.props;

const ART: Record<DoodleKind, { box: string; flat: string; line: string }> = {
  spark: {
    box: '0 0 48 48',
    flat: '<path d="M27 9 L31 21 L43 25 L31 29 L27 41 L23 29 L11 25 L23 21 Z"/>',
    line: '<path d="M24 4 C24.8 14 25.6 18 34 22 C25.6 24.2 24.8 28 24 42 C23.2 28 22.4 25 13 22 C22.4 19.6 23.2 14 24 4 Z"/>',
  },
  squiggle: {
    box: '0 0 96 32',
    flat: '<ellipse cx="54" cy="16" rx="30" ry="9"/>',
    line: '<path d="M4 20 C 12 6, 20 6, 26 17 S 42 28, 48 15 S 64 3, 70 15 S 86 28, 92 13"/>',
  },
  dots: {
    box: '0 0 48 48',
    flat: '<circle cx="27" cy="24" r="14"/>',
    line:
      '<circle class="illo__dot" cx="14" cy="14" r="2.4"/><circle class="illo__dot" cx="29" cy="10" r="2.4"/>' +
      '<circle class="illo__dot" cx="38" cy="25" r="2.4"/><circle class="illo__dot" cx="20" cy="33" r="2.4"/>',
  },
};

const art = ART[kind];
---

<svg
  class:list={['doodle', `doodle--${kind}`, `doodle--${pos}`]}
  viewBox={art.box}
  aria-hidden="true"
  focusable="false"
>
  <g class="illo__flat" filter="url(#ink-flat)" set:html={art.flat} />
  <g class="illo__line" filter="url(#ink-line)" set:html={art.line} />
</svg>
