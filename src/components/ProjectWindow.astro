---
/* A client project for the theme trial (David, 2026-11-25, second pass): the
   live site's screenshot under a faint blue wash from above, and the copy
   underneath. The card has no fill and no border of its own: it sits in a
   grid cell that draws the lines, so it never turns lighter than the page.
   The whole card is the link to the client's site; on hover or keyboard
   focus the screenshot rises 6px with a soft shadow and "Visit the site"
   turns blue and underlined. With reduced motion only the colour changes. */
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  level?: 'h2' | 'h3';
}

const { project: p, lang, level = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Heading = level;

/* Written out rather than built with a template literal, so every key keeps
   its type check. */
const copy = {
  service: { line: t('work.project.service.line'), tag: t('work.project.service.tag') },
  iconta: { line: t('work.project.iconta.line'), tag: t('work.project.iconta.tag') },
  ipda: { line: t('work.project.ipda.line'), tag: t('work.project.ipda.tag') },
}[p.key];
---

<a class="pw" href={p.url}>
  <div class="pw__media">
    <img
      src={`/assets/work/${p.key}.webp`}
      srcset={`/assets/work/${p.key}.webp 1x, /assets/work/${p.key}@2x.webp 2x`}
      width="720"
      height="450"
      alt={t('work.shot.alt', { name: p.name })}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="pw__text">
    <Heading class="pw__name" lang={p.key === 'ipda' ? 'de' : undefined}>{p.name}</Heading>
    <p class="pw__tag">{copy.tag}</p>
    <p class="pw__line">{copy.line}</p>
    <span class="pw__link"><span class="pw__visit">{t('work.visit')}</span> <span class="pw__arrow" aria-hidden="true">&rarr;</span></span>
  </div>
</a>

<style>
  .pw {
    --pw-pad: clamp(1.25rem, 2.6vw, 2.25rem);
    --pw-ease: cubic-bezier(0.2, 0.7, 0.2, 1);

    display: grid;
    grid-template-rows: auto 1fr;
    block-size: 100%;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    text-decoration: none;
  }

  .pw:focus-visible {
    outline: 2px solid var(--accent-fn);
    outline-offset: -4px;
  }

  /* The faint wash from above: blue at 10%, gone by the screenshot's middle. */
  .pw__media {
    padding: var(--pw-pad) var(--pw-pad) 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent-fn) 10%, transparent), transparent 45%);
  }

  .pw__media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    /* Seen only until the lazy image arrives. */
    background-color: color-mix(in srgb, var(--fg) 4%, transparent);
    box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0);
    transform: translateY(0);
    transition:
      transform 320ms var(--pw-ease),
      box-shadow 320ms var(--pw-ease);
  }

  .pw:focus-visible .pw__media img {
    transform: translateY(-6px);
    box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.35);
  }

  .pw__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem var(--pw-pad) var(--pw-pad);
  }

  .pw__name {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .pw__tag {
    margin: 0;
    font-size: var(--t-micro);
    color: var(--fg-muted);
  }

  .pw__line {
    margin: 0.3rem 0 0;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  /* Pushed to the bottom, so the links line up across a row of cards. */
  .pw__link {
    margin-block-start: auto;
    padding-block-start: 0.9rem;
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
    color: var(--fg);
    transition: color 200ms var(--pw-ease);
  }

  .pw__visit {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 200ms var(--pw-ease);
  }

  .pw__arrow {
    display: inline-block;
  }

  .pw:focus-visible .pw__link { color: var(--accent-fn); }
  .pw:focus-visible .pw__visit { text-decoration-color: currentColor; }

  /* Hover only where there is a pointer, so a tap does not leave a card
     stuck in its raised state. */
  @media (hover: hover) {
    .pw:hover .pw__media img {
      transform: translateY(-6px);
      box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.35);
    }

    .pw:hover .pw__link { color: var(--accent-fn); }
    .pw:hover .pw__visit { text-decoration-color: currentColor; }
  }

  /* No movement: the screenshot stays put and only the link changes colour. */
  @media (prefers-reduced-motion: reduce) {
    .pw__media img,
    .pw:hover .pw__media img,
    .pw:focus-visible .pw__media img {
      transform: none;
      box-shadow: none;
      transition: none;
    }
  }
</style>
