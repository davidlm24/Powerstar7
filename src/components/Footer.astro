---
import { useTranslations, route, CONTACT, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const pages: { key: PageKey; label: string }[] = [
  { key: 'home', label: t('nav.home') },
  { key: 'work', label: t('nav.work') },
  { key: 'services', label: t('nav.services') },
  { key: 'about', label: t('nav.about') },
  { key: 'contact', label: t('nav.contact') },
];

const legal: { key: PageKey; label: string }[] = [
  { key: 'legal', label: t('footer.legal') },
  { key: 'privacy', label: t('footer.privacy') },
];
---

{/* One component, rendered on every page in both languages. The site it
    replaces carried a 74-line footer copy-pasted into ten files — about a
    third of all the HTML on the site. */}
<footer class="site-footer invert rails">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__wordmark">DesignActiv<span aria-hidden="true">.</span></p>
      <p class="site-footer__blurb">{t('footer.blurb')}</p>
      <a class="site-footer__email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </div>

    <nav class="site-footer__nav" aria-label={t('footer.nav')}>
      <h2 class="site-footer__heading">{t('footer.nav')}</h2>
      <ul>
        {
          pages.map((item) => (
            <li>
              <a href={route(item.key, lang)} aria-current={item.key === page ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__nav" aria-label={t('footer.legalNav')}>
      <h2 class="site-footer__heading">{t('footer.legalNav')}</h2>
      <ul>
        {
          legal.map((item) => (
            <li>
              <a href={route(item.key, lang)} aria-current={item.key === page ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__base">
    <p>&copy; <span data-year>2026</span> DesignActiv. {t('footer.rights')}</p>
    <p class="site-footer__built">{t('footer.built')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--s7) var(--s4);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    gap: var(--s6) var(--s5);
    padding-block-end: var(--s6);
  }

  .site-footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    /* --weight-medium: at --t-h3 the 400 display weight disappears against
       the body copy beside it. Same reason as the header wordmark. */
    font-weight: var(--weight-medium);
    letter-spacing: -0.03em;
  }

  .site-footer__wordmark span {
    color: var(--accent);
  }

  .site-footer__blurb {
    max-width: 34ch;
    margin-block-start: var(--s2);
    color: var(--fg-muted);
    font-size: var(--t-small);
  }

  .site-footer__email {
    display: inline-block;
    margin-block-start: var(--s3);
    color: var(--fg);
    font-size: var(--t-small);
    text-underline-offset: 0.25em;
  }

  .site-footer__heading {
    font-family: var(--font-text);
    font-size: var(--t-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .site-footer__nav ul {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s3);
    display: grid;
    gap: 0.6rem;
  }

  .site-footer__nav a {
    color: var(--fg);
    font-size: var(--t-small);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__nav a[aria-current='page'] {
    color: var(--fg-muted);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    padding-block-start: var(--s4);
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
    font-size: var(--t-micro);
  }

  .site-footer__built {
    letter-spacing: 0.01em;
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
    }
  }
</style>
