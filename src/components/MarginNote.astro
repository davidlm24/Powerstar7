---
/* A handwritten aside in the margin, with an ink arrow towards what it is about.
   At most one per page.

   Decoration, by contract: aria-hidden, and it only ever repeats something the
   page already says in its own text. Nothing a visitor needs may live only in
   a note.

   Placement. Put it in the markup right after the thing it points at.
   - Up to 960px it stays in the flow there: right-aligned, tilted, no arrow.
   - Above 960px it lifts out into the margin. The caller positions it with
     custom properties on `style`, measured against the nearest positioned
     ancestor (every .rails section is one): --note-top or --note-bottom, plus
     --note-start or --note-end (distance from the left or right edge). Anchor
     from the side the target is on, so the arrow lands on it in every language.
     The arrow points left, down-left,
     up-left or up-right, towards the target.

   The face is a trimmed Caveat (scripts/subset-note-font.mjs). Its file only
   downloads on pages that show a note. */

interface Props {
  text: string;
  arrow?: 'left' | 'down-left' | 'up-left' | 'up-right';
  style?: string;
}

const { text, arrow = 'down-left', style } = Astro.props;

/* One curve per direction, in a 92×54 box. The head is two short strokes at
   the end the arrow arrives at. */
const ARROWS: Record<NonNullable<Props['arrow']>, string> = {
  left: '<path d="M86 22 C 64 14, 34 16, 8 28"/><path d="M8 28 L 19 19 M8 28 L 20 33"/>',
  'down-left': '<path d="M70 4 C 60 22, 40 38, 10 44"/><path d="M10 44 L 20 36 M10 44 L 21 49"/>',
  'up-left': '<path d="M70 50 C 60 32, 40 16, 10 10"/><path d="M10 10 L 21 5 M10 10 L 20 18"/>',
  'up-right': '<path d="M22 50 C 32 32, 52 16, 82 10"/><path d="M82 10 L 71 5 M82 10 L 72 18"/>',
};
---

<p class:list={['note', `note--${arrow}`]} aria-hidden="true" style={style}>
  <span class="note__text">{text}</span>
  <svg class="note__arrow" viewBox="0 0 92 54" focusable="false">
    <g class="illo__line" filter="url(#ink-line)" set:html={ARROWS[arrow]} />
  </svg>
</p>
