---
/* One ASCII figure (src/lib/ascii.ts) or the home hero's moving field
   (src/lib/flow.ts), drawn at build time.

   variant:
   - field: the figure in a page heading. Sits behind the text, fades out
     towards it, and shimmers (site.js).
   - aside: a smaller second figure in a later section. Shimmers. Hidden where
     the section has no free corner.
   - icon: a service icon. Faint at rest; decodes into place, character by
     character, on hover or focus (site.js).
   - flow: the home hero's abstract field. The first frame is drawn here; the
     page's script keeps it moving (Home.astro).

   Decoration, by contract: aria-hidden, and data-nosnippet so search engines
   never quote a row of dots as the page's summary. The text is plain ASCII, so
   the page's own monospace font draws it and nothing is downloaded. */
import { renderFigure, renderIcon, ICON_COLS, ICON_ROWS, type FigureName, type IconName } from '../lib/ascii';
import { renderFlow } from '../lib/flow';

interface Props {
  figure?: FigureName;
  icon?: IconName;
  variant: 'field' | 'aside' | 'icon' | 'flow';
  cols?: number;
  rows?: number;
  class?: string;
}

const { figure, icon, variant, class: className } = Astro.props;
const size = {
  field: [84, 38],
  aside: [54, 30],
  icon: [ICON_COLS, ICON_ROWS], // hand-set art, one shared canvas
  flow: [130, 66],
}[variant];
const cols = Astro.props.cols ?? size[0];
const rows = Astro.props.rows ?? size[1];

let text: string;
if (variant === 'flow') text = renderFlow(cols, rows, 0);
else if (variant === 'icon' && icon) text = renderIcon(icon, cols, rows);
else if (figure) text = renderFigure(figure, cols, rows, { dither: variant === 'field' ? 0.35 : 0.3 });
else throw new Error(`Ascii (${variant}) needs a figure or an icon`);
---

<div class:list={['ascii', `ascii--${variant}`, className]} aria-hidden="true" data-nosnippet>
  <pre
    data-shimmer={variant === 'field' || variant === 'aside' ? '' : undefined}
    data-decode={variant === 'icon' ? '' : undefined}
    data-flow={variant === 'flow' ? '' : undefined}
    data-cols={cols}
    data-rows={rows}>{text}</pre>
</div>
