---
/* The home hero's moving ASCII field (src/lib/flow.ts). The first frame is
   drawn here at build time, so the page shows it with no script at all; the
   page's own script keeps it moving (Home.astro).

   Decoration, by contract: aria-hidden, and data-nosnippet so search engines
   never quote a row of characters as the page's summary. The text is plain
   ASCII, so the page's own monospace font draws it and nothing is
   downloaded. The illustrations are pictures, not text: see Illo.astro. */
import { renderFlow } from '../lib/flow';

interface Props {
  variant: 'flow';
  cols?: number;
  rows?: number;
  class?: string;
}

const { variant, class: className } = Astro.props;
const cols = Astro.props.cols ?? 130;
const rows = Astro.props.rows ?? 66;
const text = renderFlow(cols, rows, 0);
---

<div class:list={['ascii', `ascii--${variant}`, className]} aria-hidden="true" data-nosnippet>
  <pre data-flow data-cols={cols} data-rows={rows}>{text}</pre>
</div>
