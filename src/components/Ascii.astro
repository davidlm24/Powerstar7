---
/* The home hero's moving piece (src/lib/flow.ts): an editor typing a page,
   a preview building beside it, a terminal running the build. The finished
   frame is drawn here at build time, so the page shows it with no script at
   all; the page's own script keeps it moving (Home.astro).

   Decoration, by contract: aria-hidden, and data-nosnippet so search engines
   never quote a row of characters as the page's summary. The text is drawn
   by the page's own monospace font and nothing is downloaded. */
import { renderFlow, FLOW_COLS, FLOW_ROWS } from '../lib/flow';

interface Props {
  variant: 'flow';
  cols?: number;
  rows?: number;
  class?: string;
}

const { variant, class: className } = Astro.props;
const cols = Astro.props.cols ?? FLOW_COLS;
const rows = Astro.props.rows ?? FLOW_ROWS;
const text = renderFlow(cols, rows, 0);
---

<div class:list={['ascii', `ascii--${variant}`, className]} aria-hidden="true" data-nosnippet>
  <pre data-flow data-cols={cols} data-rows={rows}>{text}</pre>
</div>
