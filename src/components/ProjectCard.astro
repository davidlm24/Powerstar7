---
/* One client project: the live site's home page in a plain browser frame,
   what the business is, and a link to the site. Used three-up on the home
   page and one-to-a-row on the Work page (`wide`). The heading level follows
   the page: h3 under the home section's h2, h2 directly under the Work h1. */
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  level?: 'h2' | 'h3';
  wide?: boolean;
}

const { project: p, lang, level = 'h3', wide = false } = Astro.props;
const t = useTranslations(lang);
const Heading = level;

/* Written out rather than built with a template literal, so every key keeps
   its type check (a template-literal key needs an `as any`). */
const copy = {
  service: { line: t('work.project.service.line'), tag: t('work.project.service.tag') },
  iconta: { line: t('work.project.iconta.line'), tag: t('work.project.iconta.tag') },
  ipda: { line: t('work.project.ipda.line'), tag: t('work.project.ipda.tag') },
}[p.key];
---

<article class:list={['project', 'dcard', wide && 'project--wide']} data-corner="tr" data-corner-from="0" data-corner-scale="0.7" data-dots="over" style="--dc-w: 150px; --dc-h: 110px;">
  <div class="project__shot">
    {/* The bar is drawn, not captured: it frames the screenshot as a website
        and names the address, without any one browser's chrome. */}
    <span class="project__bar" aria-hidden="true"><i></i><i></i><i></i><b>{p.host}</b></span>
    <img
      src={`/assets/work/${p.key}.webp`}
      srcset={`/assets/work/${p.key}.webp 1x, /assets/work/${p.key}@2x.webp 2x`}
      width="720"
      height="450"
      alt={t('work.shot.alt', { name: p.name })}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="project__text">
    <div class="project__top">
      <Heading class="project__name">{p.name}</Heading>
      <p class="project__tag">{copy.tag}</p>
    </div>
    <p class="project__line">{copy.line}</p>
    <a class="project__link" href={p.url}>{t('work.visit')}<span class="visually-hidden"> — {p.name}</span> <span aria-hidden="true">&rarr;</span></a>
  </div>
</article>

<style>
  /* A compact card (David, 2026-10-20): the screenshot cropped to the top of
     the page at 2:1, and a short body under it, the name and what the
     business is on one line. Its corner of dots sits over the top right of
     the screenshot and answers the pointer (global.css .dcard). */
  .project {
    background: var(--paper-hi);
    border: 1px solid var(--rail);
  }

  .project__shot {
    border-bottom: 1px solid var(--rail);
  }

  .project__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--rail);
    font-size: var(--t-micro);
    color: var(--fg-muted);
  }

  /* The three dots: round accent marks, the one place a curve is allowed
     besides the buttons and the cards. */
  .project__bar i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--rail);
  }

  .project__bar b {
    margin-inline-start: 6px;
    font-weight: var(--weight-text);
  }

  .project__shot img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    object-position: top;
  }

  .project__text {
    padding: var(--s2) var(--s3) var(--s3);
  }

  .project__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s2);
  }

  .project__name {
    font-size: 1.125rem;
    line-height: 1.25;
  }

  .project__tag {
    font-size: var(--t-micro);
    font-weight: var(--weight-heading);
    color: var(--fg-muted);
  }

  .project__line {
    margin-block-start: 0.35rem;
    max-width: 30ch;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--fg-muted);
  }

  .project__link {
    display: inline-block;
    margin-block-start: var(--s1);
    font-size: var(--t-small);
    font-weight: var(--weight-medium);
  }

  /* Work page: the screenshot large on the left, the text beside it. */
  .project--wide {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: center;
  }

  .project--wide .project__shot {
    border-bottom: 0;
    border-inline-end: 1px solid var(--rail);
  }

  .project--wide .project__shot img {
    aspect-ratio: 16 / 10;
  }

  .project--wide .project__text {
    padding: var(--s4);
  }

  .project--wide .project__name {
    font-size: var(--t-h3);
  }

  .project--wide .project__line {
    max-width: 44ch;
    font-size: var(--t-body);
  }

  @media (max-width: 59.99rem) {
    .project--wide {
      grid-template-columns: minmax(0, 1fr);
    }

    .project--wide .project__shot {
      border-inline-end: 0;
      border-bottom: 1px solid var(--rail);
    }

    .project--wide .project__text {
      padding: var(--s2) var(--s3) var(--s3);
    }
  }
</style>
