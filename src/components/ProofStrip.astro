---
import { useTranslations, metrics, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* The numbers come from scripts/measure.mjs, which reads the real build
   output. Until that has run there is nothing true to print, so the strip
   renders nothing at all rather than a plausible-looking placeholder — the
   entire point of this section is that its numbers are checkable. */
const measured = metrics.measuredAt !== null && metrics.weightKb > 0;

const cells = measured
  ? [
      { value: String(metrics.weightKb), unit: 'KB', label: t('home.proof.weight') },
      { value: String(metrics.requests), unit: '', label: t('home.proof.requests') },
      { value: String(metrics.thirdPartyRequests), unit: '', label: t('home.proof.thirdParty') },
      { value: String(metrics.cookies), unit: '', label: t('home.proof.cookies') },
    ]
  : [];
---

{
  measured && (
    <section class="proof" aria-labelledby="proof-h">
      <div class="container">
        <p class="label" id="proof-h">
          {t('home.proof.label')}
        </p>

        <dl class="proof__grid">
          {cells.map((cell) => (
            <div class="proof__cell">
              <dt class="proof__label">{cell.label}</dt>
              <dd class="proof__value">
                {cell.value}
                {cell.unit && <span class="proof__unit">{cell.unit}</span>}
              </dd>
            </div>
          ))}
        </dl>

        <p class="proof__note">
          {t('home.proof.note')}{' '}
          <span class="proof__date">
            <time datetime={metrics.measuredAt}>{metrics.measuredAt}</time>
          </span>
        </p>
      </div>
    </section>
  )
}

<style>
  .proof {
    padding-block: var(--s6) var(--s7);
    border-block: 1px solid var(--rule);
    background: var(--paper-hi);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block-start: var(--s5);
  }

  /* Hairlines between cells, not around them — a spec sheet, not four cards.
     The old site had twenty surface classes, twelve of which were the same
     rounded rectangle with a hairline and a bevel. */
  .proof__cell + .proof__cell {
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: var(--s4);
  }

  .proof__cell {
    padding-inline-end: var(--s4);
  }

  .proof__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-stat);
    font-weight: var(--weight-display);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .proof__unit {
    font-size: 0.35em;
    letter-spacing: 0;
    margin-inline-start: 0.2em;
    color: var(--fg-muted);
  }

  .proof__label {
    font-size: var(--t-micro);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-block-end: var(--s2);
    min-height: 2.6em;
  }

  .proof__note {
    max-width: 54ch;
    margin-block-start: var(--s5);
    color: var(--fg-muted);
    font-size: var(--t-small);
  }

  .proof__date {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
  }

  @media (max-width: 52rem) {
    .proof__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s4) 0;
    }

    /* On two columns the third cell starts a new row, so its left hairline
       would hang off the start of the row. */
    .proof__cell:nth-child(odd) {
      border-inline-start: 0;
      padding-inline-start: 0;
    }
  }
</style>
