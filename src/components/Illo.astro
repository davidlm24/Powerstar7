---
/* One illustration: a finished sticker image (scripts/illustrations.mjs) —
   "D1 + adesivo" (David, 2026-10-14): the 3D scene softly shaded, Bayer-
   dithered to 1 bit, blue dots on pale sticker paper with a halo, tilt
   baked in. Plain <img>: no colouring, no filters, the same file on light
   and dark grounds; 1x and 2x through srcset.

   variant:
   - icon:  a service icon. Hidden at rest so only its zone's soft wash
            shows; it appears on the zone's hover or keyboard focus — the
            one animation (global.css). Always visible where there is no
            hover (touch).
   - field: the page-heading figure, behind the text, faded towards the
            copy by its wrapper's masks.
   - aside: the smaller second figure, wide screens only.
   - sticker: the home hero's picture and its seal, always visible and
            loaded eagerly, since they are in the first screen.

   Decoration by contract: aria-hidden, empty alt, data-nosnippet. */
import manifest from '../data/illo.json';

export type IlloName = keyof typeof manifest;

interface Props {
  name: IlloName;
  variant: 'icon' | 'field' | 'aside' | 'sticker';
  class?: string;
}

const { name, variant, class: className } = Astro.props;
const { w, h } = manifest[name];
const src = `/assets/illo/${name}.png`;
const src2 = `/assets/illo/${name}@2x.png`;
---

<div class:list={['illo', `illo--${variant}`, className]} aria-hidden="true" data-nosnippet>
  <img
    src={src}
    srcset={`${src} 1x, ${src2} 2x`}
    width={w}
    height={h}
    alt=""
    loading={variant === 'field' || variant === 'sticker' ? 'eager' : 'lazy'}
    decoding="async"
  />
</div>
