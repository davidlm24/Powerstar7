---
/* One illustration: half-block text (scripts/illustrations.mjs), lit 3D
   scenes in space ░ ▒ ▓ █ ▀ ▄. The icons are flat 2D drawings, oversized
   and cut at their right edge, always in blue; everything shimmers like the
   page figures, and an icon also DECODEs — the character flicker — when its
   zone is hovered or focused (site.js).

   variant:
   - icon:  a service icon, in its lane or column; drifts in on reveal when
            the parent asks (data-reveal).
   - field: the figure in a page heading, behind the text, fading towards it.
   - aside: the smaller second figure in a later section, wide screens only.

   Decoration by contract: aria-hidden, and data-nosnippet. */
import manifest from '../data/illo.json';

export type IlloName = keyof typeof manifest;

interface Props {
  name: IlloName;
  variant: 'icon' | 'field' | 'aside';
  /** Inside a dark band: the light-on-dark render. */
  onDark?: boolean;
  class?: string;
}

const { name, variant, onDark, class: className } = Astro.props;
const entry = manifest[name] as { cols: number; rows: number; light: string; dark?: string };
const text = (onDark && entry.dark) || entry.light;
---

<div class:list={['illo', `illo--${variant}`, className]} aria-hidden="true" data-nosnippet>
  <pre
    data-decode={variant === 'icon' ? '' : undefined}
    data-shimmer
    data-cols={entry.cols}>{text}</pre>
</div>
