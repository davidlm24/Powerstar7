---
/* One illustration: a finished 1-bit image (scripts/illustrations.mjs).
   Drawn from zero for its page (David, 2026-10-19), in tone made for the
   dither, Bayer-dithered to blue dots and nothing else, tilt baked in.
   Plain <img>, 1x and 2x through srcset, as the initial and no-JS render;
   on the pages that opt in, dither-site.js lays a live canvas over it,
   drawn from the same ink (public/assets/dither), so the print itself can
   move: the hero develops, the icons answer the pointer.

   ink: 'blue' (the default) or 'on-ink', the dots for a dark band.

   variant:
   - icon:  a service icon, at full ink always (David, 2026-10-19). Where
            the page runs the engine, its zone's hover relights it from the
            pointer, as the hero picture does (dither-site.js).
   - field: the page-heading figure, behind the text, faded towards the
            copy by its wrapper's masks.
   - aside: the smaller second figure, wide screens only.
   - sticker: the home hero's picture and its seal, always visible and
            loaded eagerly, since they are in the first screen.

   Decoration by contract: aria-hidden, empty alt, data-nosnippet. */
import manifest from '../data/illo.json';

export type IlloName = keyof typeof manifest;

interface Props {
  name: IlloName;
  variant: 'icon' | 'field' | 'aside' | 'sticker';
  ink?: 'blue' | 'on-ink';
  class?: string;
}

const { name, variant, ink = 'blue', class: className } = Astro.props;
const { w, h } = manifest[name];
const base = `/assets/illo/${name}${ink === 'on-ink' ? '-dark' : ''}`;
const full = { src: `${base}.png`, srcset: `${base}.png 1x, ${base}@2x.png 2x` };
const eager = variant === 'field' || variant === 'sticker';
---

<div class:list={['illo', `illo--${variant}`, (variant === 'field' || variant === 'aside') && 'print-in', className]} aria-hidden="true" data-nosnippet data-illo={name} data-ink={ink}>
  <img
    src={full.src}
    srcset={full.srcset}
    width={w}
    height={h}
    alt=""
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</div>
