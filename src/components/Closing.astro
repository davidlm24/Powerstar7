---
import { useTranslations, route, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  label?: string;
}

const { lang, label } = Astro.props;
const t = useTranslations(lang);
---

{/* What replaced .cta-band — the identical blue slab that closed six of the
    old site's ten pages. One line of type at heading scale, between two
    hairlines, and the whole line is the link. */}
<section class="closing">
  <div class="container">
    <a class="closing__link" href={route('contact', lang)}>
      <span>{label ?? t('home.cta')}</span>
      <span class="closing__arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .closing {
    padding-block: var(--s6) var(--s8);
  }

  .closing__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding-block: var(--s4);
    border-block: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--weight-display);
    letter-spacing: var(--tr-heading);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .closing__link:hover {
    color: var(--accent-fn);
  }

  .closing__arrow {
    transition: transform var(--dur) var(--ease);
  }

  .closing__link:hover .closing__arrow {
    transform: translateX(0.5rem);
  }
</style>
