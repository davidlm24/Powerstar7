---
import { useTranslations, route, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  label?: string;
}

const { lang, label } = Astro.props;
const t = useTranslations(lang);
---

{/* What replaced .cta-band — the identical blue slab that closed six of the
    old site's ten pages. One line of type at heading scale, between two
    hairlines, and the whole line is the link. */}
<section class="closing rails">
  <div class="container">
    <a class="closing__link" href={route('contact', lang)}>
      <span>{label ?? t('home.cta')}</span>
      <span class="closing__arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .closing {
    padding-block: var(--s6) var(--section-y);
  }

  .closing__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding-block: var(--s4);
    /* Start only. The bottom line had --s8 of empty paper beneath it and then
       the footer's ink ground, which carries that boundary by tone — the same
       reason the footer needs no top line. Two lines bracketing one element is
       a frame, which is the shape being retired; one line above it divides the
       CTA from the section before it, which is a separator. */
    border-block-start: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--t-h2);
    /* h2 scale, so h2 weight. */
    font-weight: var(--weight-heading);
    letter-spacing: var(--tr-heading);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .closing__link:hover {
    color: var(--accent-fn);
  }

  .closing__arrow {
    transition: transform var(--dur) var(--ease);
  }

  .closing__link:hover .closing__arrow {
    transform: translateX(0.5rem);
  }
</style>
