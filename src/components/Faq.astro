---
/* The questions people ask, as one section of the grid: a title cell, then
   one full-width row per question, each a <details>/<summary>, so it opens
   and closes with no JavaScript, is keyboard-reachable, and has its expanded
   state announced. Shared by Services and Pricing; each page passes its own
   heading and questions. Answers carry prices as §amount§ markers
   (src/data/pricing.ts), drawn by <Priced>. */
import Accent from './Accent.astro';
import Priced from './Priced.astro';
import Pluses from './Pluses.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  heading: string;
  items: { q: string; a: string }[];
}

const { lang, heading, items } = Astro.props;
---

<section class="frame">
  <Pluses />
  <div class="grid">
    <div class="cell cell--head span-4">
      <h2 class="head__h"><Accent text={heading} /></h2>
    </div>
    {
      items.map((f) => (
        <details class="cell faq-item span-4">
          <summary class="faq-item__q">{f.q}</summary>
          <p class="faq-item__a">
            <Priced text={f.a} lang={lang} />
          </p>
        </details>
      ))
    }
  </div>
  <Pluses end />
</section>
