# Netlify / Cloudflare Pages redirect rules.
# (Apache hosts use .htaccess instead; see DEPLOY.md.)

# --- Never serve the design handoff bundle ----------------------------------
# It lives in the repo as reference material, not as site content.
/design           /404.html    404
/design/*         /404.html    404

# --- Legacy Sitejet URLs (301, preserve SEO) --------------------------------
/en               /            301
/en/*             /:splat      301

# The old Portuguese version only ever had these two pages. Redirect to the
# English equivalents until a PT version is (re)built.
/pt               /            301
/pt/sobre-nos     /about-us    301
/pt/*             /            301

# --- Strip .html so canonical extensionless URLs are the only public form ---
/index.html       /                        301
/*.html           /:splat                  301
