# Apache configuration for powerstar7.com
# Mirrors _redirects (Netlify / Cloudflare Pages). See DEPLOY.md.

RewriteEngine On

# --- Never serve the design handoff bundle ----------------------------------
# It lives in the repo as reference material, not as site content.
RewriteRule ^design(/.*)?$ - [R=404,L]

# --- Legacy Sitejet URLs (301, preserve SEO) --------------------------------

# The old site served everything under /en/… — send those to the new roots.
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^en/(.*)$ /$1 [R=301,L]

# The Portuguese version only ever had these two pages. Redirect to the
# English equivalents until a PT version is (re)built.
RewriteRule ^pt/sobre-nos/?$ /about-us [R=301,L]
RewriteRule ^pt(/.*)?$ / [R=301,L]

# --- Strip .html so extensionless URLs are the only public form -------------

RewriteRule ^index\.html$ / [R=301,L]

# Only redirect a browser-visible .html request, never the internal rewrite
# below (guarded by THE_REQUEST, which holds the original request line).
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Custom error page ------------------------------------------------------
# Served as an internal subrequest, so the THE_REQUEST-guarded .html rule
# above does not rewrite it away.
ErrorDocument 404 /404.html

# --- Serve /about-us from about-us.html ------------------------------------

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# --- Cache headers ----------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On

  # Fingerprint-free assets: revalidate daily, so a redeploy is picked up
  # without stale CSS lingering for a year.
  ExpiresByType text/css                "access plus 1 day"
  ExpiresByType application/javascript  "access plus 1 day"

  # Images and fonts are content-stable; cache them hard.
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"

  # HTML must always revalidate.
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.(woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# --- MIME types -------------------------------------------------------------

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# --- Compression ------------------------------------------------------------

# webp/woff2 are already compressed — listing them here would only burn CPU.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript \
    image/svg+xml application/xml text/plain
</IfModule>
